<view class="page">
  <view class="head">
    <text class="title display">营业设置</text>
    <text class="sub">每一餐可以单独开关和截单时间</text>
  </view>

  <view wx:if="{{loading}}" class="skeleton sk"></view>

  <block wx:else>
    <view wx:for="{{mealViews}}" wx:key="id" class="meal-card card">
      <view class="meal-top">
        <view class="meal-name">{{item.name}}</view>
        <switch
          checked="{{item.open}}"
          color="#FF6B35"
          data-index="{{index}}"
          bindchange="onToggle"
        />
      </view>
      <view class="meal-row">
        <text class="meal-label">截单时间</text>
        <picker
          mode="time"
          value="{{item.deadline}}"
          data-index="{{index}}"
          bindchange="onDeadline"
        >
          <view class="time-pill">{{item.deadline}}</view>
        </picker>
      </view>
      <view class="meal-status {{item.open ? 'open' : 'closed'}}">
        {{item.open ? '营业中' : '休息中'}}
      </view>
    </view>

    <view class="card block">
      <view class="block-title">休息时显示</view>
      <input
        class="note"
        placeholder="比如：今天休息，明天见"
        value="{{closedNote}}"
        maxlength="40"
        bindinput="onNote"
      />
    </view>

    <view
      class="save-btn {{saving ? 'disabled' : ''}}"
      bindtap="onSave"
    >{{saving ? '保存中…' : '保存营业设置'}}</view>
  </block>
</view>
