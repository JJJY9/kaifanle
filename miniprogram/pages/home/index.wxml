<view class="page" style="padding-top: {{navPad}}px;">
  <view class="header">
    <view class="top-line">
      <text class="date">{{dateText}}</text>
      <view class="status {{isOpen ? 'open' : 'closed'}}">
        <view class="status-dot"></view>
        <text>{{isOpen ? '营业中' : '休息中'}}</text>
      </view>
    </view>

    <view class="title-line">
      <text class="big-title">{{greetText}}</text>
      <view class="sticker-title">干饭!</view>
    </view>
    <view class="sub-row">
      <view class="sub-line">今天也给你开小灶</view>
      <view class="surprise" bindtap="onSurprise">🎲 帮我选</view>
    </view>

    <view wx:if="{{weekText}}" class="week-summary" bindtap="onWeekReport">
      <text>🍚 {{weekText}}</text>
      <text class="week-copy" catchtap="onCopyWeek">复制</text>
    </view>

    <view class="meal-tabs">
      <view
        wx:for="{{meals}}"
        wx:key="id"
        class="meal-tab {{selectedMeal === item.id ? 'active' : ''}}"
        data-meal="{{item.id}}"
        bindtap="onSelectMeal"
      >{{item.name}}</view>
    </view>

    <view class="date-row">
      <picker
        mode="date"
        start="{{todayDate}}"
        end="{{maxDate}}"
        value="{{selectedDate}}"
        bindchange="onSelectDate"
      >
        <view class="date-pill">📅 {{menuDateLabel}}</view>
      </picker>
      <view
        class="date-quick {{selectedDate === todayDate ? 'active' : ''}}"
        data-date="{{todayDate}}"
        bindtap="onQuickDate"
      >今天</view>
      <view
        class="date-quick {{selectedDate === tomorrowDate ? 'active' : ''}}"
        data-date="{{tomorrowDate}}"
        bindtap="onQuickDate"
      >明天</view>
      <text wx:if="{{selectedDate !== todayDate}}" class="date-hint">预订 / 预览</text>
    </view>
    <view wx:if="{{deadlineText}}" class="deadline-hint">⏰ {{deadlineText}}</view>
    <view wx:if="{{activeOrder}}" class="active-order" bindtap="onActiveOrderTap">
      <view class="active-order-main">
        <view class="active-order-label-row">
          <text class="active-order-label">今天这单 · {{activeOrder.mealText}}</text>
          <text wx:if="{{activeOrder.messageBadge}}" class="active-order-badge">新回复 {{activeOrder.messageBadge}}</text>
        </view>
        <text class="active-order-text">{{activeOrder.statusText}} · {{activeOrder.summary}}</text>
        <text wx:if="{{activeOrder.expectedText}}" class="active-order-eta">⏰ {{activeOrder.expectedText}}</text>
        <text wx:if="{{activeOrder.lastMessageText}}" class="active-order-message">💬 {{activeOrder.lastMessageText}}</text>
      </view>
      <text class="active-order-arrow">查看 ›</text>
    </view>
    <view wx:if="{{couponExpiring}}" class="coupon-reminder" bindtap="onCouponReminder">
      🎟 有 {{couponExpiring}} 张券 3 天内到期，去用掉 ›
    </view>
    <view wx:if="{{pendingReviews}}" class="review-reminder" bindtap="onPendingReviews">
      ⭐ 有 {{pendingReviews}} 单吃完还没评价，去夸夸 ›
    </view>
    <view wx:if="{{specialBanner}}" class="special-reminder" bindtap="onWeekMenus">
      <text>{{specialBanner}}</text>
      <text class="special-arrow">去饭表 ›</text>
    </view>
    <view wx:if="{{busyText}}" class="busy-line">{{busyText}}</view>
    <view wx:if="{{mealNotice}}" class="meal-notice">{{mealNotice}}</view>
    <view wx:if="{{notice}}" class="notice-box {{noticeLong ? 'tappable' : ''}}" bindtap="onToggleNotice">
      <text class="notice-tag">店长说</text>
      <text class="notice-text {{noticeLong && !noticeExpanded ? 'clamp' : ''}}">{{notice}}</text>
      <text wx:if="{{noticeLong}}" class="notice-toggle">{{noticeExpanded ? '收起' : '展开'}}</text>
    </view>

    <view class="week-entry" bindtap="onWeekMenus">
      <text class="week-entry-text">📅 本周饭表 · 提前看 7 天</text>
      <text class="week-entry-arrow">›</text>
    </view>

    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="想吃点什么？搜搜看"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">×</view>
    </view>

    <view wx:if="{{!keyword && searchHistory.length}}" class="search-history">
      <text class="search-history-label">最近搜</text>
      <view
        wx:for="{{searchHistory}}"
        wx:key="*this"
        class="search-history-chip"
        data-keyword="{{item}}"
        bindtap="onHistoryTap"
        bindlongpress="onRemoveHistory"
      >{{item}}</view>
      <text class="search-history-clear" bindtap="onClearHistory">清空</text>
    </view>

    <view class="fav-row">
      <view
        class="fav-chip {{onlyFavorites ? 'active' : ''}}"
        bindtap="onToggleFavorites"
      >{{favoriteLabel}}</view>
      <view
        class="fav-chip {{onlyAvailable ? 'active' : ''}}"
        bindtap="onToggleAvailable"
      >只看能点的</view>
      <view
        wx:if="{{dislikes.length}}"
        class="fav-chip {{avoidDislikes ? 'active' : ''}}"
        bindtap="onToggleAvoidDislikes"
      >避开忌口</view>
    </view>

    <scroll-view wx:if="{{spiceFilters.length > 1}}" scroll-x class="spice-row">
      <view
        wx:for="{{spiceFilters}}"
        wx:key="key"
        class="spice-chip {{spiceFilter === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSpiceFilter"
      >{{item.label}}</view>
    </scroll-view>

    <scroll-view wx:if="{{tagFilters.length > 1}}" scroll-x class="tag-filter-row">
      <view
        wx:for="{{tagFilters}}"
        wx:key="key"
        class="tag-filter-chip {{tagFilter === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTagFilter"
      >{{item.label}}<text wx:if="{{item.count}}" class="tag-filter-count">{{item.count}}</text></view>
    </scroll-view>

    <view wx:if="{{lastOrder}}" class="last-order" bindtap="onRepeatLast">
      <view class="last-order-info">
        <text class="last-order-label">上次吃 · {{lastOrder.mealText}}</text>
        <text class="last-order-name">{{lastOrder.summary}}</text>
      </view>
      <view class="last-order-go">再来一份 ↺</view>
    </view>

    <scroll-view wx:if="{{sections.length}}" scroll-x class="cat-jump">
      <view
        wx:for="{{sections}}"
        wx:key="id"
        class="cat-jump-chip"
        data-id="{{item.id}}"
        bindtap="onCategoryJump"
      >{{item.name}}</view>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="skeleton sk-hero"></view>
    <view class="skeleton sk-row"></view>
    <view class="skeleton sk-row"></view>
  </view>

  <block wx:elif="{{keyword}}">
    <view wx:if="{{searchResults.length}}" class="dish-list search-list">
      <dish-card
        wx:for="{{searchResults}}"
        wx:key="id"
        dish="{{item}}"
        bind:select="onDishTap"
        bind:add="onQuickAdd"
        bind:recipe="onRecipeTap"
      />
    </view>
    <block wx:if="{{!searchResults.length}}">
      <view wx:if="{{searchSuggestions.length}}" class="search-suggest">
        <view class="search-suggest-title">要不要试试这些</view>
        <view class="search-suggest-row">
          <view
            wx:for="{{searchSuggestions}}"
            wx:key="id"
            class="search-suggest-chip"
            data-id="{{item.id}}"
            bindtap="onSuggestionTap"
          >{{item.name}}</view>
        </view>
      </view>
      <empty-state
        wx:if="{{!searchSuggestions.length}}"
        title="没搜到"
        desc="换个关键词试试，或者去许愿池点个菜"
      />
    </block>
  </block>

  <block wx:elif="{{sections.length}}">
    <view wx:if="{{hero}}" class="hero" bindtap="onHeroTap">
      <view class="hero-media" style="background: {{hero.color}};">
        <image wx:if="{{(hero.image || hero.cartoon) && !heroImageFailed}}" class="hero-img" src="{{hero.image || hero.cartoon}}" mode="{{hero.cartoon && !hero.image ? 'aspectFit' : 'aspectFill'}}" binderror="onHeroImageError" />
        <text wx:else class="hero-char">{{hero.emoji || hero.char}}</text>
        <view class="hero-sticker">{{heroTag}}</view>
      </view>
      <view class="hero-body">
        <view class="hero-name">{{hero.name}}</view>
        <view class="hero-desc">{{hero.desc}}</view>
        <view class="hero-switch" catchtap="onNextHero">换一道 ↻</view>
        <view class="hero-foot">
          <view class="hero-price">
            <text class="currency">¥</text>
            <text class="price-num">{{hero.price}}</text>
          </view>
          <view class="hero-add" catchtap="onHeroAdd">+</view>
        </view>
      </view>
    </view>

    <view wx:for="{{sections}}" wx:key="id" class="section" id="cat-{{item.id}}">
      <view class="section-head">
        <view class="section-dot" style="background: {{item.color}};"></view>
        <text class="section-title">{{item.name}}</text>
        <view class="section-line"></view>
      </view>
      <view class="dish-list">
        <dish-card
          wx:for="{{item.dishes}}"
          wx:key="id"
          dish="{{item}}"
          bind:select="onDishTap"
          bind:add="onQuickAdd"
          bind:recipe="onRecipeTap"
        />
      </view>
    </view>
  </block>

  <empty-state
    wx:else
    title="{{emptyTitle}}"
    desc="{{emptyDesc}}"
    actionText="{{emptyAction}}"
    bind:action="onEmptyAction"
  />
</view>

<cart-bar
  count="{{cartCount}}"
  total="{{cartTotal}}"
  otherCount="{{otherCartCount}}"
  bind:checkout="onCheckout"
  bind:overview="onCartOverview"
/>

<view
  wx:if="{{showCatBar && sections.length}}"
  class="cat-bar"
  style="padding-top: {{navPad}}px;"
>
  <scroll-view scroll-x class="cat-bar-scroll">
    <view
      wx:for="{{sections}}"
      wx:key="id"
      class="cat-bar-chip"
      data-id="{{item.id}}"
      bindtap="onCategoryJump"
    >{{item.name}}</view>
  </scroll-view>
</view>

<sku-sheet
  id="skuSheet"
  visible="{{skuVisible}}"
  dish="{{activeDish}}"
  bind:close="onSkuClose"
  bind:add="onSkuAdd"
/>
