<view class="page">
  <view class="head">
    <text class="title display">口味与地址</text>
    <text class="sub">让每一顿都合口味</text>
  </view>

  <view wx:if="{{loading}}" class="skeleton sk"></view>

  <empty-state
    wx:elif="{{loadFailed}}"
    title="档案加载失败"
    desc="没有拿到已保存的口味和地址，先别保存，免得覆盖掉"
    actionText="重试"
    bind:action="onRetryLoad"
  />

  <block wx:else>
    <view class="card block">
      <view class="field">
        <text class="label">忌口</text>
        <input
          class="input"
          placeholder="逗号分隔，如：香菜，葱"
          value="{{dislikesText}}"
          bindinput="onDislikes"
        />
      </view>
      <view class="field">
        <text class="label">口味</text>
        <input
          class="input"
          placeholder="逗号分隔，如：微辣，少盐"
          value="{{tastesText}}"
          bindinput="onTastes"
        />
      </view>
      <view class="field">
        <text class="label">常用地址</text>
        <input
          class="input"
          placeholder="送到哪里"
          value="{{address}}"
          maxlength="60"
          bindinput="onAddress"
        />
      </view>
    </view>

    <view
      class="save-btn {{saving ? 'disabled' : ''}}"
      bindtap="onSave"
    >{{saving ? '保存中…' : '保存'}}</view>
  </block>
</view>
