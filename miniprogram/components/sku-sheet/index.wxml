<view
  wx:if="{{visible && dish}}"
  class="mask"
  bindtap="onClose"
  catchtouchmove="noop"
>
  <view class="sheet" catchtap="noop">
    <view class="handle"></view>
    <view class="close" bindtap="onClose">×</view>

    <view class="head">
      <view class="media" style="background: {{dish.color}};">
        <text class="media-char">{{dish.char}}</text>
      </view>
      <view class="head-info">
        <view class="name">{{dish.name}}</view>
        <view class="desc">{{dish.desc}}</view>
        <view class="tags">
          <text wx:for="{{dish.tags}}" wx:key="*this" class="tag">{{item}}</text>
        </view>
      </view>
    </view>

    <scroll-view class="body" scroll-y>
      <block wx:if="{{spicyLevels.length}}">
        <view class="field-label">辣度</view>
        <view class="chips">
          <view
            wx:for="{{spicyLevels}}"
            wx:key="*this"
            class="chip {{spicyIndex === index ? 'active' : ''}}"
            data-index="{{index}}"
            bindtap="onSpicy"
          >{{item}}</view>
        </view>
      </block>

      <block wx:if="{{addons.length}}">
        <view class="field-label">加料</view>
        <view
          wx:for="{{addons}}"
          wx:key="id"
          class="addon {{addonChecked[item.id] ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onToggleAddon"
        >
          <text class="addon-name">{{item.name}}</text>
          <view class="addon-right">
            <text class="addon-price">+¥{{item.price}}</text>
            <view class="checkbox">{{addonChecked[item.id] ? '✓' : ''}}</view>
          </view>
        </view>
      </block>

      <view class="field-label">备注</view>
      <input
        class="note"
        placeholder="比如：少放葱花"
        value="{{note}}"
        bindinput="onNote"
      />
    </scroll-view>

    <view class="foot">
      <view class="stepper">
        <view class="step {{qty <= 1 ? 'disabled' : ''}}" bindtap="onMinus">−</view>
        <text class="qty">{{qty}}</text>
        <view class="step" bindtap="onPlus">+</view>
      </view>
      <view class="confirm" bindtap="onConfirm">加购 · ¥{{totalPrice}}</view>
    </view>
  </view>
</view>
