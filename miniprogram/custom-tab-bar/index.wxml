<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="onSwitch"
  >
    <text class="tab-text {{selected === index ? 'active' : ''}}">{{item.text}}</text>
    <view wx:if="{{index === 0 && cartCount > 0}}" class="tab-badge">{{cartCount > 99 ? '99+' : cartCount}}</view>
  </view>
</view>
