.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
}

.head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx 20rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sub {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
  padding: 0 22rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
}

.search-icon {
  font-size: 26rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 26rpx;
  font-weight: 700;
}

.section {
  margin-top: 30rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.section-dot {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #111111;
  border-radius: 6rpx;
}

.section-name {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 32rpx;
  font-weight: 800;
}

.section-line {
  flex: 1;
  margin-left: 6rpx;
  border-top: 3rpx dashed #111111;
  opacity: 0.35;
}

.list {
  padding: 4rpx 22rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 3rpx dashed rgba(17, 17, 17, 0.12);
}

.row:last-child {
  border-bottom: none;
}

.dot {
  flex: 0 0 84rpx;
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #111111;
  border-radius: 20rpx;
  overflow: hidden;
}

.dot-img {
  width: 100%;
  height: 100%;
}

.dot-char {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 40rpx;
  font-weight: 800;
  transform: rotate(-6deg);
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 800;
}

.step-preview {
  margin-top: 2rpx;
  color: #5C5C5C;
  font-size: 21rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.meta {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.row-fav {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-right: 2rpx;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: 28rpx;
  line-height: 1;
  color: #111111;
}

.row-fav.on {
  background: #FF5C8A;
  color: #FFFFFF;
}

.steps {
  padding: 4rpx 14rpx;
  background: #FFFDF6;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 800;
}

.arrow {
  color: #8A8A8A;
  font-size: 24rpx;
}

.sk {
  height: 400rpx;
}

.page-inner {
  padding-top: 20rpx;
}
