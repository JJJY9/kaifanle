<view class="page">
  <view class="head">
    <view class="title-row">
      <text class="title display">经营月报</text>
      <view class="sticker">近 {{report.days || 30}} 天</view>
    </view>
    <text wx:if="{{report}}" class="sub">{{report.startDate}} 至 {{report.endDate}} · 只统计未取消订单</text>
    <view class="range-row">
      <view
        class="range-chip {{range === 7 ? 'active' : ''}}"
        data-range="7"
        bindtap="onRange"
      >近 7 天</view>
      <view
        class="range-chip {{range === 30 ? 'active' : ''}}"
        data-range="30"
        bindtap="onRange"
      >近 30 天</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="skeleton sk-card"></view>
    <view class="skeleton sk-card"></view>
  </view>

  <empty-state
    wx:elif="{{error}}"
    title="月报加载失败"
    desc="{{error}}"
    actionText="再试一次"
    bind:action="onRetry"
  />

  <block wx:elif="{{report}}">
    <view class="stats-card card">
      <view class="stat">
        <text class="stat-num">¥{{report.revenue}}</text>
        <text class="stat-label">{{report.days}} 天营收</text>
      </view>
      <view class="divider"></view>
      <view class="stat">
        <text class="stat-num">{{report.totalOrders}}</text>
        <text class="stat-label">订单</text>
      </view>
      <view class="divider"></view>
      <view class="stat">
        <text class="stat-num">¥{{report.avgOrder}}</text>
        <text class="stat-label">客单价</text>
      </view>
    </view>

    <view wx:if="{{report.costStats && report.costStats.qty}}" class="cost-card card">
      <view class="cost-head">
        <text class="cost-title">成本与毛利</text>
        <text class="cost-sub">只算已填成本的菜 · {{report.costStats.qty}} 份</text>
      </view>
      <view class="cost-grid">
        <view class="cost-item">
          <text class="cost-num">¥{{report.costStats.revenue}}</text>
          <text class="cost-label">营收</text>
        </view>
        <view class="cost-item">
          <text class="cost-num">¥{{report.costStats.cost}}</text>
          <text class="cost-label">成本</text>
        </view>
        <view class="cost-item">
          <text class="cost-num">¥{{report.costStats.profit}}</text>
          <text class="cost-label">毛利</text>
        </view>
        <view class="cost-item">
          <text class="cost-num">{{report.costStats.margin}}%</text>
          <text class="cost-label">毛利率</text>
        </view>
      </view>
    </view>

    <view wx:if="{{monthlyGoal > 0}}" class="month-goal-card card">
      <view class="month-goal-head">
        <text class="month-goal-title">本月营收目标</text>
        <text class="month-goal-amount">¥{{report.monthRevenue}} / ¥{{monthlyGoal}}</text>
      </view>
      <view class="month-goal-track">
        <view class="month-goal-fill" style="width: {{monthGoalPercent}}%;"></view>
      </view>
      <view class="month-goal-text">{{monthGoalText}}</view>
    </view>

    <view wx:if="{{monthCompare}}" class="compare card">
      <view class="compare-head">
        <text class="compare-title">上月同期 · {{monthCompare.rangeText}}</text>
        <text class="compare-badge {{monthCompare.trend}}">{{monthCompare.text}}</text>
      </view>
      <view class="compare-row">
        <text class="compare-label">营收</text>
        <text class="compare-value">¥{{monthCompare.revenue}} <text class="compare-prev">/ 本月至今 ¥{{report.monthRevenue}}</text></text>
      </view>
      <view class="compare-row">
        <text class="compare-label">订单</text>
        <text class="compare-value">{{monthCompare.orders}} 单 <text class="compare-prev">/ 本月至今 {{report.monthOrders || 0}} 单</text></text>
      </view>
    </view>

    <view wx:if="{{health}}" class="health-card card">
      <view class="health-head">
        <text class="health-title">数据体检</text>
        <text class="health-sub">共 {{health.total}} 道菜</text>
      </view>
      <view class="health-row">
        <view
          class="health-item jump {{health.noRecipe ? 'warn' : ''}}"
          data-filter="missing"
          bindtap="onHealthJump"
        >
          <text class="health-num">{{health.noRecipe}}</text>
          <text class="health-label">缺做法 ›</text>
        </view>
        <view
          class="health-item jump {{health.lowStock ? 'warn' : ''}}"
          data-filter="low"
          bindtap="onHealthJump"
        >
          <text class="health-num">{{health.lowStock}}</text>
          <text class="health-label">低库存 ≤{{health.lowStockThreshold}} ›</text>
        </view>
        <view
          class="health-item jump"
          data-filter="soldout"
          bindtap="onHealthJump"
        >
          <text class="health-num">{{health.soldout}}</text>
          <text class="health-label">售罄 ›</text>
        </view>
        <view
          class="health-item jump"
          data-filter="off"
          bindtap="onHealthJump"
        >
          <text class="health-num">{{health.off}}</text>
          <text class="health-label">已下架 ›</text>
        </view>
      </view>
      <view
        wx:if="{{health.noCost}}"
        class="health-note"
        data-filter="cost"
        bindtap="onHealthJump"
      >还有 {{health.noCost}} 道菜没填成本，毛利会漏算 ›</view>
    </view>

    <view wx:if="{{report.ratedCount}}" class="rating-line card">
      <text>评价 {{report.ratedCount}} 条</text>
      <text>平均 {{report.avgRating}} 分</text>
      <text>好评率 {{report.goodRate}}%</text>
      <text>已回复 {{report.repliedRatings}} 条 · {{report.replyRate}}%</text>
    </view>

    <view wx:if="{{report.topTags && report.topTags.length}}" class="tags-line card">
      <text class="tags-title">她被夸</text>
      <view
        wx:for="{{report.topTags}}"
        wx:key="name"
        class="report-tag"
        data-name="{{item.name}}"
        bindtap="onTagTap"
      >{{item.name}} ×{{item.count}}</view>
    </view>

    <view wx:if="{{compare}}" class="compare card">
      <view class="compare-head">
        <text class="compare-title">本周 vs 上周</text>
        <text class="compare-badge {{compare.trend}}">{{compare.revenueText}}</text>
      </view>
      <view class="compare-row">
        <text class="compare-label">营收</text>
        <text class="compare-value">¥{{compare.thisRevenue}} <text class="compare-prev">/ ¥{{compare.prevRevenue}}</text></text>
      </view>
      <view class="compare-row">
        <text class="compare-label">订单</text>
        <text class="compare-value">{{compare.thisCount}} 单 <text class="compare-prev">/ {{compare.prevCount}} 单 · {{compare.countText}}</text></text>
      </view>
    </view>

    <view wx:if="{{report.mealStats && report.mealStats.length}}" class="meal-stats card">
      <view
        wx:for="{{report.mealStats}}"
        wx:key="meal"
        class="meal-stat"
        data-meal="{{item.meal}}"
        bindtap="onMealTap"
      >
        <text class="meal-stat-name">{{item.meal === 'breakfast' ? '早餐' : (item.meal === 'lunch' ? '午餐' : '晚餐')}}</text>
        <text class="meal-stat-revenue">¥{{item.revenue}}</text>
        <text class="meal-stat-count">{{item.count}} 单</text>
      </view>
    </view>

    <view wx:if="{{categoryStats.length}}" class="category-stats card">
      <view class="compare-head">
        <text class="compare-title">分类表现</text>
        <text class="compare-sub">{{report.days}} 天</text>
      </view>
      <view
        wx:for="{{categoryStats}}"
        wx:key="id"
        class="category-row"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >
        <view class="category-name-wrap">
          <text class="category-name">{{item.name}}</text>
          <text wx:if="{{item.profit !== null}}" class="category-profit">毛利 ¥{{item.profit}} · {{item.margin}}%</text>
        </view>
        <text class="category-qty">{{item.qty}} 份</text>
        <text class="category-revenue">¥{{item.revenue}}</text>
      </view>
    </view>
    <view wx:if="{{categoryStats.length}}" class="dish-export-btn" bindtap="onExportCategories">复制分类表现 CSV</view>
    <view wx:if="{{categoryExportCount}}" class="export-hint">已复制 {{categoryExportCount}} 个分类，可以直接粘贴到表格</view>

    <view
      class="export-btn {{exporting ? 'disabled' : ''}}"
      bindtap="onExport"
    >{{exporting ? '导出中…' : '复制订单 CSV'}}</view>
    <view
      class="export-btn {{exportingFile ? 'disabled' : ''}}"
      bindtap="onExportFile"
    >{{exportingFile ? '生成中…' : '导出 CSV 文件'}}</view>
    <view
      class="export-btn {{backupBusy ? 'disabled' : ''}}"
      bindtap="onBackup"
    >{{backupBusy ? '打包中…' : '备份全部数据 JSON'}}</view>
    <view wx:if="{{exportCount}}" class="export-hint">已复制当前区间 {{exportCount}} 单，可以直接粘贴到表格</view>
    <view wx:if="{{exportedFile}}" class="export-hint">CSV 文件已生成，可通过微信发送或保存</view>
    <view wx:if="{{backupCount}}" class="export-hint">已备份 {{backupCount}} 项数据，JSON 文件可发送或保存</view>

    <view class="chart card">
      <view class="chart-head">
        <view class="chart-title">每天营收</view>
        <view class="chart-total">单日最高 ¥{{maxAmount}}</view>
      </view>
      <view class="chart-bars">
        <view wx:for="{{bars}}" wx:key="date" class="chart-col">
          <view class="chart-bar-wrap">
            <view
              class="chart-bar {{item.amount ? '' : 'empty'}}"
              style="height: {{item.height}}%;"
            ></view>
          </view>
          <text class="chart-label">{{item.showLabel ? item.label : ''}}</text>
        </view>
      </view>
    </view>

    <view class="section-title display">菜品排行</view>
    <view wx:if="{{!report.topDishes.length}}" class="empty-line">这 {{report.days}} 天还没有卖出的菜</view>
    <view wx:for="{{report.topDishes}}" wx:key="name" class="dish-row card" data-id="{{item.id}}" bindtap="onDishTap">
      <view class="rank {{index < 3 ? 'top' : ''}}">{{index + 1}}</view>
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-sub">卖出 {{item.qty}} 份 · ¥{{item.revenue}}</view>
      </view>
      <view class="dish-bar-wrap">
        <view
          class="dish-bar"
          style="width: {{report.topDishes[0].qty ? (item.qty / report.topDishes[0].qty * 100) : 0}}%;"
        ></view>
      </view>
    </view>

    <view class="section-title display">卖得最少</view>
    <view wx:if="{{!report.slowDishes.length}}" class="empty-line">菜单里的菜都在正常卖</view>
    <view wx:for="{{report.slowDishes}}" wx:key="name" class="dish-row card" data-id="{{item.id}}" bindtap="onDishTap">
      <view class="rank slow">{{index + 1}}</view>
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-sub">{{item.qty ? '卖出 ' + item.qty + ' 份 · ¥' + item.revenue : '这 ' + report.days + ' 天没卖出去'}}</view>
      </view>
      <view
        class="slow-toggle {{item.status === 'soldout' ? 'restore' : ''}} {{slowBusyId === item.id ? 'busy' : ''}}"
        data-id="{{item.id}}"
        catchtap="onSlowToggle"
      >{{slowBusyId === item.id ? '处理中…' : (item.status === 'soldout' ? '恢复供应' : '设售罄')}}</view>
    </view>

    <view class="dish-export-btn" bindtap="onExportDishes">复制全部菜品销量 CSV</view>
    <view class="dish-export-btn" bindtap="onExportDishesFile">{{dishesFileBusy ? '生成中…' : '分享菜品销量 CSV 文件'}}</view>
    <view wx:if="{{dishesFileReady}}" class="export-hint">CSV 文件已生成，可通过微信发送或保存</view>

    <view class="section-title display">好评菜品</view>
    <view wx:if="{{!report.topRatedDishes.length}}" class="empty-line">还没有满 {{report.minRatedOrders}} 次评价的菜</view>
    <view wx:for="{{report.topRatedDishes}}" wx:key="name" class="dish-row card">
      <view class="rank {{index < 3 ? 'top' : ''}}">{{index + 1}}</view>
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-sub">平均 {{item.avgRating}}/3 分 · {{item.ratedCount}} 次评价</view>
      </view>
    </view>

    <view class="foot-note">
      完成 {{report.completed}} 单 · 取消 {{report.cancelled}} 单
    </view>
  </block>
</view>
