.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
}

.head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sticker {
  padding: 2rpx 12rpx;
  background: #FF5C8A;
  color: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 10rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 20rpx;
  font-weight: 800;
  transform: rotate(4deg);
}

.sub {
  margin-top: 8rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.sk-card {
  height: 200rpx;
  margin-bottom: 24rpx;
  border-radius: 40rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
}

.sort-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.cat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.cat-chip {
  padding: 6rpx 16rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.cat-chip.active {
  background: #2D9CFF;
  color: #FFFFFF;
  box-shadow: 2rpx 2rpx 0 #111111;
}

.sort-chip {
  padding: 6rpx 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.sort-chip.active {
  background: #FFD23F;
  box-shadow: 2rpx 2rpx 0 #111111;
}

.search-icon {
  font-size: 24rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  background: #EFE9DC;
  border-radius: 999rpx;
  color: #5C5C5C;
  font-size: 28rpx;
  line-height: 1;
}

.fav-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  margin-bottom: 18rpx;
}

.fav-media {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 120rpx;
  border: 3rpx solid #111111;
  border-radius: 20rpx;
  overflow: hidden;
}

.fav-img {
  width: 100%;
  height: 100%;
}

.fav-char {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 52rpx;
  font-weight: 800;
}

.fav-info {
  flex: 1;
  min-width: 0;
}

.fav-name {
  font-size: 28rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-desc {
  margin-top: 2rpx;
  color: #5C5C5C;
  font-size: 21rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 6rpx;
}

.fav-time {
  margin-top: 4rpx;
  color: #9A9A9A;
  font-size: 18rpx;
}

.fav-tag {
  padding: 1rpx 10rpx;
  background: #FFF7DA;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
}

.fav-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.fav-price {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 30rpx;
  font-weight: 800;
}

.fav-arrow {
  color: #5C5C5C;
  font-size: 24rpx;
}

.foot-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 26rpx;
  background: #FF6B35;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 6rpx 6rpx 0 #111111;
  font-size: 30rpx;
  font-weight: 800;
}

.foot-btn:active {
  transform: translate(6rpx, 6rpx);
  box-shadow: none;
}

.foot-btn.poster {
  margin-top: 18rpx;
  background: #FFD23F;
  font-size: 26rpx;
}

.foot-btn.disabled {
  opacity: 0.5;
}

.foot-link {
  padding: 10rpx 20rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 1080px;
  pointer-events: none;
}
