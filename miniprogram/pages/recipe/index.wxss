.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
}

.hero {
  display: flex;
  gap: 22rpx;
  padding: 20rpx;
}

.hero-media {
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #111111;
  border-radius: 26rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-char {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 100rpx;
  font-weight: 800;
  transform: rotate(-8deg);
}

.hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.dish-name {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name-row .dish-name {
  flex: 1;
  min-width: 0;
}

.fav {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  background: #FFFDF6;
  border: 3rpx solid #111111;
  border-radius: 50%;
  font-size: 30rpx;
  line-height: 1;
}

.fav.on {
  background: #FF5C8A;
}

.dish-desc {
  color: #5C5C5C;
  font-size: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 4rpx;
}

.tag {
  padding: 2rpx 14rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 800;
  transform: rotate(-2deg);
}

.steps-card {
  margin-top: 24rpx;
  padding: 24rpx;
}

.steps-title {
  margin-bottom: 18rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.step-row {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 3rpx dashed rgba(17, 17, 17, 0.12);
}

.step-row:last-child {
  border-bottom: none;
}

.step-no {
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF6B35;
  border: 3rpx solid #111111;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 800;
}

.step-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-steps {
  padding: 28rpx;
  background: #FFFDF6;
  border: 3rpx dashed #111111;
  border-radius: 20rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  text-align: center;
}

.actions {
  margin-top: 28rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 8rpx 8rpx 0 #111111;
}

.btn:active {
  transform: translate(8rpx, 8rpx);
  box-shadow: none;
}

.btn-primary {
  background: #FF6B35;
}

.sk {
  height: 600rpx;
}
