<view
  wx:if="{{dish}}"
  class="dish {{dish.status === 'soldout' ? 'is-soldout' : ''}}"
  bindtap="onTap"
>
  <view class="media" style="background: {{dish.color}};">
    <image wx:if="{{dish.image}}" class="media-img" src="{{dish.image}}" mode="aspectFill" />
    <text wx:else class="media-char">{{dish.char}}</text>
    <view wx:if="{{dish.tags[0] && dish.status !== 'soldout'}}" class="media-tag">{{dish.tags[0]}}</view>
    <view wx:if="{{dish.status === 'soldout'}}" class="soldout-mask">
      <text class="soldout-text">售罄</text>
    </view>
  </view>

  <view class="body">
    <view class="name">{{dish.name}}</view>
    <view class="desc">{{dish.desc}}</view>
    <view class="foot">
      <view class="price-wrap">
        <text class="currency">¥</text>
        <text class="price">{{dish.price}}</text>
      </view>
      <view
        wx:if="{{showAdd && dish.status !== 'soldout'}}"
        class="add"
        catchtap="onAdd"
      >+</view>
      <text wx:elif="{{dish.status === 'soldout'}}" class="soldout-hint">明天赶早</text>
    </view>
  </view>
</view>
