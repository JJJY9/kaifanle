.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
}

.status-card {
  padding: 28rpx;
}

.status-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-badge {
  padding: 8rpx 24rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.status-badge.accepted {
  background: #2D9CFF;
  color: #FFFFFF;
}

.status-badge.cooking {
  background: #FF6B35;
}

.status-badge.ready {
  background: #2FBF71;
}

.status-badge.completed {
  background: #EFE9DC;
  color: #5C5C5C;
}

.status-badge.cancelled {
  background: #E8E8E8;
  color: #B8B8B8;
}

.status-no {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 32rpx;
  font-weight: 800;
  color: #5C5C5C;
}

.status-sub {
  margin-top: 16rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.cancel-reason {
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  background: #E8E8E8;
  border: 3rpx dashed #B8B8B8;
  border-radius: 14rpx;
  color: #5C5C5C;
  font-size: 22rpx;
  font-weight: 700;
}

.queue-tip {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  background: #FFF7DA;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.ready-tip {
  display: inline-block;
  margin-top: 18rpx;
  padding: 10rpx 20rpx;
  background: #2FBF71;
  border: 3rpx solid #111111;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
  transform: rotate(-1deg);
}

.notify-ready {
  display: inline-block;
  margin-top: 18rpx;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 24rpx;
  font-weight: 800;}

.notify-ready:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: none;
}

.urge {
  display: inline-block;
  margin-top: 18rpx;
  padding: 10rpx 24rpx;
  background: #FF5C8A;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 24rpx;
  font-weight: 800;
}

.urge:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: none;
}

.urge.cooling {
  background: #FFFDF6;
  color: #5C5C5C;
  box-shadow: none;
}

.cancel-order {
  display: inline-block;
  margin-top: 18rpx;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  background: #FFFDF6;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  font-weight: 800;
}

.cancel-order:active {
  transform: translate(3rpx, 3rpx);
}

.copy-order {
  display: inline-block;
  margin-top: 18rpx;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  background: #E9F1FF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  color: #2D6FD9;
  font-size: 24rpx;
  font-weight: 800;
}

.copy-order:active {
  transform: translate(3rpx, 3rpx);
}

.block {
  padding: 28rpx;
  margin-top: 24rpx;
}

.block-title {
  margin-bottom: 20rpx;
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 32rpx;
  font-weight: 800;
}

.timeline {
  display: flex;
  flex-direction: column;
}

.tstep {
  display: flex;
  gap: 20rpx;
  min-height: 92rpx;
}

.rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 24rpx;
}

.dot {
  width: 22rpx;
  height: 22rpx;
  margin-top: 6rpx;
  background: #FFFFFF;
  border: 3rpx solid #B8B8B8;
  border-radius: 50%;
}

.line {
  flex: 1;
  width: 0;
  margin: 4rpx 0;
  border-left: 3rpx dashed #B8B8B8;
}

.tstep.done .dot {
  background: #111111;
  border-color: #111111;
}

.tstep.done .line {
  border-color: #111111;
}

.tinfo {
  flex: 1;
  padding-bottom: 20rpx;
}

.ttitle {
  color: #B8B8B8;
  font-size: 28rpx;
  font-weight: 800;
}

.tstep.done .ttitle {
  color: #111111;
}

.ttime {
  margin-top: 2rpx;
  color: #5C5C5C;
  font-size: 22rpx;
}

.item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
}

.item-name {
  font-size: 28rpx;
  font-weight: 700;
}

.item-qty {
  color: #5C5C5C;
  font-size: 22rpx;
}

.item-spec {
  margin-top: 2rpx;
  color: #5C5C5C;
  font-size: 22rpx;
}

.item-price {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 28rpx;
  font-weight: 800;
}

.order-note {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.edit-note {
  margin-top: 10rpx;
  align-self: flex-start;
  color: #2D9CFF;
  font-size: 22rpx;
  font-weight: 800;
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 3rpx dashed rgba(17, 17, 17, 0.2);
  font-weight: 800;
}

.total-price {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 40rpx;
}

.receipt-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 0;
  color: #5C5C5C;
  font-size: 24rpx;
}

.receipt-row text:last-child {
  max-width: 68%;
  text-align: right;
  word-break: break-all;
}

.receipt-stamp {
  display: inline-block;
  margin-top: 20rpx;
  padding: 6rpx 18rpx;
  border: 3rpx solid #FF5C8A;
  border-radius: 8rpx;
  color: #FF5C8A;
  font-size: 26rpx;
  font-weight: 800;
  transform: rotate(-3deg);
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.rating-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.rating-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.rating-tag {
  padding: 6rpx 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.rating-tag.active {
  background: #2FBF71;
  box-shadow: 2rpx 2rpx 0 #111111;
}

.rating-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 0;
  background: #FFFDF6;
  border: 3rpx solid #111111;
  border-radius: 20rpx;
}

.rating-option.active {
  background: #FFD23F;
  box-shadow: 4rpx 4rpx 0 #111111;
  transform: rotate(-1deg);
}

.rating-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.rating-label {
  font-size: 22rpx;
  font-weight: 800;
}

.rating-input {
  height: 76rpx;
  padding: 0 20rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.rating-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin-top: 16rpx;
  background: #2FBF71;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 25rpx;
  font-weight: 800;
}

.rating-submit:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: none;
}

.rating-submit.disabled {
  opacity: 0.5;
}

.owner-reply {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background: #FFFDF6;
  border: 3rpx solid #111111;
  border-radius: 20rpx;
}

.owner-reply-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.owner-reply-label {
  padding: 2rpx 12rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  transform: rotate(-2deg);
}

.owner-reply-time {
  color: #B8B8B8;
  font-size: 20rpx;
}

.owner-reply-text {
  font-size: 25rpx;
  line-height: 1.5;
}

.actions .btn {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
}

.actions .btn.busy {
  opacity: 0.5;
}

.sk-detail {
  height: 900rpx;
}
