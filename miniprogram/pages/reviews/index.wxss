.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
}

.head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sticker {
  padding: 2rpx 12rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 10rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 20rpx;
  font-weight: 800;
  transform: rotate(4deg);
}

.sub {
  margin-top: 8rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.sk-card {
  height: 260rpx;
  margin-bottom: 24rpx;
  border-radius: 40rpx;
}

.stats-card {
  display: flex;
  align-items: stretch;
  padding: 22rpx 12rpx;
  margin-bottom: 22rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-num {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.stat-label {
  margin-top: 2rpx;
  color: #5C5C5C;
  font-size: 21rpx;
}

.divider {
  width: 3rpx;
  background: rgba(17, 17, 17, 0.15);
  border-radius: 999rpx;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.filter-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 22rpx;
  font-weight: 800;
}

.filter-chip:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.filter-chip.active {
  background: #111111;
  color: #FFFFFF;
}

.review {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.review-top {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.rating-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.rating-badge.good {
  background: #2FBF71;
}

.rating-badge.normal {
  background: #FFD23F;
}

.rating-badge.bad {
  background: #FF5C8A;
  color: #FFFFFF;
}

.rating-emoji {
  font-size: 24rpx;
}

.review-date {
  color: #5C5C5C;
  font-size: 21rpx;
}

.review-dishes {
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.4;
}

.review-feedback {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.review-feedback.muted {
  color: #B8B8B8;
}

.owner-reply {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  background: #FFF7DA;
  border: 3rpx solid #111111;
  border-radius: 16rpx;
}

.owner-reply-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.owner-reply-label {
  padding: 2rpx 10rpx;
  background: #FFD23F;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
  transform: rotate(-2deg);
}

.owner-reply-time {
  color: #B8B8B8;
  font-size: 18rpx;
}

.owner-reply-text {
  display: block;
  font-size: 23rpx;
  line-height: 1.5;
}

.review-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 3rpx dashed rgba(17, 17, 17, 0.15);
}

.review-no {
  color: #5C5C5C;
  font-size: 20rpx;
}

.review-arrow {
  font-size: 21rpx;
  font-weight: 800;
}
