.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
}

.head {
  padding: 8rpx 4rpx 20rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sub {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.block {
  padding: 24rpx;
  margin-bottom: 22rpx;
}

.import-input {
  width: 100%;
  height: 360rpx;
  box-sizing: border-box;
  padding: 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.import-tip {
  margin-top: 12rpx;
  color: #5C5C5C;
  font-size: 21rpx;
  line-height: 1.5;
}

.preview {
  padding: 20rpx 24rpx;
  margin-bottom: 22rpx;
}

.preview-head {
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.preview-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 0;
  border-top: 2rpx dashed #E0E0E0;
}

.preview-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.preview-name {
  font-size: 24rpx;
  font-weight: 700;
}

.preview-meta {
  margin-top: 2rpx;
  color: #5C5C5C;
  font-size: 20rpx;
}

.preview-error {
  color: #D9431C;
  font-size: 20rpx;
  font-weight: 700;
}

.preview-ok {
  color: #2FBF71;
  font-size: 20rpx;
  font-weight: 800;
}

.import-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  background: #FF6B35;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 6rpx 6rpx 0 #111111;
  font-size: 30rpx;
  font-weight: 800;
}

.import-btn:active {
  transform: translate(6rpx, 6rpx);
  box-shadow: none;
}

.import-btn.disabled {
  opacity: 0.6;
}

.import-result {
  margin-top: 18rpx;
  padding: 14rpx 20rpx;
  background: #E8F8EE;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  font-size: 23rpx;
  font-weight: 700;
}
