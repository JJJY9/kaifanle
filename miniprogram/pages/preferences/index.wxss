.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
}

.head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx 24rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sub {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.block {
  padding: 26rpx;
}

.field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 3rpx dashed rgba(17, 17, 17, 0.12);
}

.field:last-child {
  border-bottom: none;
}

.label {
  flex: 0 0 120rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.input {
  flex: 1;
  height: 76rpx;
  padding: 0 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  font-size: 26rpx;
}

.date-row {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-picker {
  flex: 1;
}

.date-value {
  height: 76rpx;
  padding: 0 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 70rpx;
}

.date-value.placeholder {
  color: #9A9A9A;
  font-weight: 400;
}

.date-clear {
  flex: 0 0 auto;
  padding: 12rpx 8rpx;
  color: #FF5C8A;
  font-size: 22rpx;
  font-weight: 800;
}

.date-hint {
  margin-top: 14rpx;
  color: #5C5C5C;
  font-size: 22rpx;
  line-height: 1.5;
}

.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin-top: 28rpx;
  background: #FF6B35;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 7rpx 7rpx 0 #111111;
  font-size: 32rpx;
  font-weight: 800;
}

.save-btn:active {
  transform: translate(7rpx, 7rpx);
  box-shadow: none;
}

.save-btn.disabled {
  opacity: 0.6;
}

.sk {
  height: 520rpx;
}
