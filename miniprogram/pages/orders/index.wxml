<view class="page">
  <view class="head">
    <text class="title display">我的订单</text>
    <text class="sub">她点的每一顿，都记在这儿</text>
    <view wx:if="{{monthText}}" class="month-line" bindtap="onGoFootprint">{{monthText}} <text class="month-arrow">›</text></view>
  </view>

  <view class="filter-row">
    <view
      class="filter-tab {{filter === 'all' ? 'active' : ''}}"
      data-filter="all"
      bindtap="onSelectFilter"
    >全部 {{counts.all}}</view>
    <view
      class="filter-tab {{filter === 'active' ? 'active' : ''}}"
      data-filter="active"
      bindtap="onSelectFilter"
    >进行中 {{counts.active}}</view>
    <view
      class="filter-tab {{filter === 'done' ? 'active' : ''}}"
      data-filter="done"
      bindtap="onSelectFilter"
    >已结束 {{counts.done}}</view>
    <view
      class="filter-tab {{filter === 'rate' ? 'active' : ''}}"
      data-filter="rate"
      bindtap="onSelectFilter"
    >待评价 {{counts.rate}}</view>
    <view
      class="filter-tab {{filter === 'preorder' ? 'active' : ''}}"
      data-filter="preorder"
      bindtap="onSelectFilter"
    >预订 {{counts.preorder}}</view>
  </view>

  <view class="meal-row">
    <view class="meal-chip {{meal === 'all' ? 'active' : ''}}" data-meal="all" bindtap="onSelectMeal">全部餐次</view>
    <view class="meal-chip {{meal === 'breakfast' ? 'active' : ''}}" data-meal="breakfast" bindtap="onSelectMeal">早餐</view>
    <view class="meal-chip {{meal === 'lunch' ? 'active' : ''}}" data-meal="lunch" bindtap="onSelectMeal">午餐</view>
    <view class="meal-chip {{meal === 'dinner' ? 'active' : ''}}" data-meal="dinner" bindtap="onSelectMeal">晚餐</view>
  </view>

  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜订单号、菜名或日期"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onSearch"
    />
    <view wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">×</view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="skeleton sk-row"></view>
    <view class="skeleton sk-row"></view>
  </view>

  <empty-state
    wx:elif="{{error}}"
    title="订单加载失败"
    desc="{{error}}"
    actionText="再试一次"
    bind:action="onRetry"
  />

  <block wx:elif="{{displayOrders.length}}">
    <block wx:for="{{displayOrders}}" wx:key="id">
      <view
        wx:if="{{item.showHeader}}"
        class="group-label"
        data-date="{{item.groupKey}}"
        bindtap="onToggleDate"
        bindlongpress="onCopyDayOrders"
      >{{item.dateText}} {{item.groupDateText}} · {{item.groupCount}} 单 <text class="group-toggle">{{item.collapsed ? '展开' : '收起'}}</text></view>
      <view
        wx:if="{{!item.collapsed}}"
        class="order card"
        data-id="{{item.id}}"
        data-no="{{item.no}}"
        bindtap="onTapOrder"
        bindlongpress="onCopyOrderNo"
      >
        <view class="order-top">
          <view class="order-id">
            <view wx:if="{{item.thumb}}" class="order-thumb">
              <image class="order-thumb-img" src="{{item.thumb}}" mode="aspectFill" lazy-load />
            </view>
            <text class="no">#{{item.no}}</text>
          </view>
          <view class="order-top-right">
            <text wx:if="{{item.messageBadge}}" class="message-badge">新留言 {{item.messageBadge}}</text>
            <text wx:if="{{item.isPreorder}}" class="preorder-chip">预订</text>
            <text wx:if="{{item.rated}}" class="rated-chip">{{item.ratingEmoji ? item.ratingEmoji + ' ' : ''}}已评</text>
            <text wx:if="{{item.replied}}" class="replied-chip">已回复</text>
            <text wx:if="{{item.waitedText}}" class="waited-chip">{{item.waitedText}}</text>
            <view class="status {{item.status}}">{{item.statusText}}</view>
          </view>
        </view>
        <view class="order-summary">{{item.summary}}</view>
        <view wx:if="{{item.noteText}}" class="order-note-preview">备注：{{item.noteText}}</view>
        <view wx:if="{{item.lastMessageText}}" class="order-last-message">💬 {{item.lastMessageText}}</view>
        <view class="order-meta">{{item.dateText}} · {{item.mealText}} · 共 {{item.totalQty}} 份 · {{item.timeText}}</view>
        <view class="order-foot">
          <text class="order-amount">¥{{item.amount}}</text>
          <text class="order-arrow">查看 →</text>
        </view>
      </view>
    </block>
  </block>

  <empty-state
    wx:elif="{{orders.length}}"
    title="{{emptyTitle}}"
    desc="{{emptyDesc}}"
    actionText="{{emptyAction}}"
    bind:action="onClearSearch"
  />

  <empty-state
    wx:else
    title="还没有订单"
    desc="去首页点一顿，锅已经热好了"
    actionText="去点餐"
    bind:action="onGoHome"
  />

  <view
    wx:if="{{hasMore}}"
    class="load-more {{loadingMore ? 'disabled' : ''}}"
    bindtap="onLoadMore"
  >{{loadingMore ? '加载中…' : '加载更多订单'}}</view>

  <view wx:if="{{showBackTop}}" class="back-top" bindtap="onBackTop">↑ 顶部</view>
</view>
