<view wx:if="{{error}}" class="page">
  <empty-state
    title="加载失败"
    desc="{{error}}"
    actionText="再试一次"
    bind:action="onRetry"
  />
</view>

<view wx:elif="{{forbidden}}" class="page">
  <empty-state
    title="厨房重地"
    desc="只有掌勺人能进"
    actionText="回我的"
    bind:action="onBack"
  />
</view>

<view wx:else class="page">
  <view class="head">
    <view class="title display">厨房端</view>
    <view class="sub">管理员视图 · 只有你能看到</view>
  </view>

  <view class="notify-bar">
    <view class="notify-btn" bindtap="onSubscribeNotice">订阅新订单提醒</view>
    <view class="notify-btn settings" bindtap="onBusiness">营业设置</view>
    <view class="notify-btn rest {{todayClosed ? 'closed' : ''}}" bindtap="onToggleTodayClosed">{{todayClosed ? '恢复营业' : '今天休息'}}</view>
    <view class="notify-btn menu" bindtap="onMenu">排菜单</view>
    <view class="notify-btn week" bindtap="onWeekMenus">本周饭表</view>
    <view class="notify-btn report" bindtap="onReport">经营月报</view>
    <view class="notify-btn copy" bindtap="onCopySummary">复制清单</view>
    <text class="notify-hint">一次授权提醒下一单</text>
  </view>

  <view wx:if="{{loading}}" class="skeleton sk-row"></view>

  <block wx:else>
    <view wx:if="{{stats}}" class="stats-card card">
      <view class="stat">
        <view class="stat-num">{{stats.orderCount}}</view>
        <view class="stat-label">今日订单</view>
      </view>
      <view class="stat">
        <view class="stat-num">¥{{stats.revenue}}</view>
        <view class="stat-label">今日营收</view>
      </view>
      <view class="stat wide">
        <view class="stat-top">{{stats.topDish || '还没开张'}}</view>
        <view class="stat-label">今日最常点</view>
      </view>
    </view>

    <view wx:if="{{dailyGoal > 0 && stats}}" class="goal-card card">
      <view class="goal-head">
        <text class="goal-title">今日营收目标</text>
        <text class="goal-amount">¥{{stats.revenue}} / ¥{{dailyGoal}}</text>
      </view>
      <view class="goal-track">
        <view class="goal-fill" style="width: {{goalPercent}}%;"></view>
      </view>
      <view class="goal-text">{{goalText}}</view>
    </view>

    <view wx:if="{{specialDays.length}}" class="special-card card">
      <view class="special-head">
        <text class="special-title">重要日子提醒</text>
        <text class="special-sub">未来 30 天 · 只有你能看到</text>
      </view>
      <view
        wx:for="{{specialDays}}"
        wx:key="key"
        class="special-row {{item.urgent ? 'urgent' : ''}}"
      >
        <text class="special-emoji">{{item.emoji}}</text>
        <text class="special-label">{{item.label}}</text>
        <text class="special-date">{{item.dateText}}</text>
        <text class="special-days">{{item.daysText}}</text>
      </view>
      <view wx:if="{{specialDaysMore}}" class="special-more">还有 {{specialDaysMore}} 个重要日子未展示</view>
      <view wx:if="{{specialDaysError}}" class="special-more">刷新失败，显示的是上次结果</view>
    </view>

    <view wx:if="{{specialDaysError && !specialDays.length}}" class="special-error card">
      <text class="special-error-text">{{specialDaysError}}</text>
      <view class="special-retry" bindtap="onRetrySpecialDays">重试</view>
    </view>

    <view wx:if="{{todo.pending || todo.replies || todo.lowStock || todo.preorders}}" class="todo-card card">
      <view class="todo-head">
        <text class="todo-title">今日待办</text>
        <view class="todo-head-right">
          <text class="todo-sub">点一下跳过去</text>
          <view
            wx:if="{{todo.lowStock}}"
            class="todo-restock {{restockingAll ? 'busy' : ''}}"
            catchtap="onRestockAll"
          >{{restockingAll ? '补货中…' : '全部补5'}}</view>
        </view>
      </view>
      <view class="todo-row">
        <view wx:if="{{todo.pending}}" class="todo-item pending" data-target="orders" bindtap="onTodoTap">
          <text class="todo-num">{{todo.pending}}</text>
          <text class="todo-label">进行中的单</text>
        </view>
        <view wx:if="{{todo.replies}}" class="todo-item replies" data-target="replies" bindtap="onTodoTap">
          <text class="todo-num">{{todo.replies}}</text>
          <text class="todo-label">评价待回复</text>
        </view>
        <view wx:if="{{todo.lowStock}}" class="todo-item stock" data-target="stock" bindtap="onTodoTap">
          <text class="todo-num">{{todo.lowStock}}</text>
          <text class="todo-label">快卖完了</text>
        </view>
        <view wx:if="{{todo.preorders}}" class="todo-item preorders" data-target="preorders" bindtap="onTodoTap">
          <text class="todo-num">{{todo.preorders}}</text>
          <text class="todo-label">未来预订</text>
        </view>
      </view>
    </view>

    <view wx:if="{{weekStats}}" class="week-line">
      近 7 天 {{weekStats.count}} 单 · ¥{{weekStats.revenue}} · 累计 {{weekStats.totalCount}} 单
      <text wx:if="{{weekStats.topDish}}"> · 本周最爱 {{weekStats.topDish}}</text>
    </view>
    <view wx:if="{{stats && stats.ratedCount}}" class="week-line">
      今日好评 {{stats.goodRatings}} · 平均 {{stats.avgRating}} 分（{{stats.ratedCount}} 人评）
    </view>
    <view class="summary-actions">
      <view class="summary-copy" bindtap="onCopyTodaySummary">📋 复制今日小结</view>
      <view class="summary-copy" bindtap="onDailyPosterTap">{{posterPath ? '🖼 预览小结图' : (posterMaking ? '生成中…' : '🖼 生成小结图')}}</view>
    </view>

    <view wx:if="{{weekBarTotal > 0}}" class="chart card">
      <view class="chart-head">
        <view class="chart-title">近 7 天营收</view>
        <view class="chart-total">¥{{weekBarTotal}}</view>
      </view>
      <view class="chart-bars">
        <view wx:for="{{weekBars}}" wx:key="key" class="chart-col">
          <view class="chart-bar-wrap">
            <view
              class="chart-bar {{item.amount ? '' : 'empty'}}"
              style="height: {{item.height}}%;"
            ></view>
          </view>
          <text class="chart-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="prep card">
      <view class="prep-head" bindtap="onTogglePrep">
        <view class="prep-text">
          <view class="prep-title">今日备菜</view>
          <view class="prep-sub">所有未完成订单汇总</view>
        </view>
        <view class="prep-badge">{{prepTotal}} 份 {{showPrep ? '▾' : '▸'}}</view>
      </view>
      <block wx:if="{{showPrep}}">
        <view wx:if="{{!prepGroups.length}}" class="empty-line">今天还没有要备的菜</view>
        <view wx:if="{{prepGroups.length}}" class="prep-copy" bindtap="onCopyPrep">复制采购清单</view>
        <view wx:if="{{prepGroups.length}}" class="prep-copy" bindtap="onCopyPrepCsv">复制备菜 CSV</view>
        <view wx:if="{{prepGroups.length}}" class="prep-copy" bindtap="onSharePrepPoster">{{prepPosterMaking ? '生成中…' : '生成采购图'}}</view>
        <view wx:if="{{prepPosterPath}}" class="prep-copy" bindtap="onPreviewPrepPoster">预览采购图</view>
        <view wx:for="{{prepGroups}}" wx:key="meal" wx:for-item="group" class="prep-group">
          <view class="prep-group-head">
            <view class="prep-group-title">{{group.mealText}} · {{group.total}} 份<text wx:if="{{group.allergyText}}" class="prep-allergy"> · 含 {{group.allergyText}}</text></view>
            <view class="prep-group-copy" data-meal="{{group.meal}}" catchtap="onCopyPrepMeal">复制这餐</view>
          </view>
          <view wx:for="{{group.items}}" wx:key="name" wx:for-item="dish" class="prep-row">
            <text class="prep-name">{{dish.name}}</text>
            <text class="prep-qty">×{{dish.qty}}</text>
          </view>
        </view>
        <view wx:if="{{prepIngredients.length}}" class="prep-ingredients">
          <view class="prep-group-title">采购食材</view>
          <view wx:for="{{prepIngredients}}" wx:key="key" class="prep-row">
            <text class="prep-name">{{item.name}}</text>
            <text class="prep-ingredient-amount">{{item.text}}</text>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{preorders.length}}" class="preorder card" id="preorder-section">
      <view class="preorder-head" bindtap="onTogglePreorders">
        <view class="prep-text">
          <view class="prep-title">未来预订</view>
          <view class="prep-sub">提前下的单，到日子再做</view>
        </view>
        <view class="prep-badge">{{preorders.length}} 单 {{showPreorders ? '▾' : '▸'}}</view>
      </view>
      <block wx:if="{{showPreorders}}">
        <view
          wx:for="{{preorders}}"
          wx:key="id"
          class="preorder-row"
          data-id="{{item.id}}"
          bindtap="onHistoryTap"
        >
          <view class="preorder-row-top">
            <text class="preorder-date">{{item.dateText}} · {{item.mealText}}</text>
            <text wx:if="{{item.slotUpdated}}" class="slot-updated">改过时间</text>
            <view class="status {{item.status}}">{{item.statusText}}</view>
          </view>
          <view class="preorder-summary">#{{item.no}} · {{item.summary}}</view>
          <view wx:if="{{item.allergyText}}" class="order-allergy">⚠️ 含过敏原：{{item.allergyText}}</view>
        </view>
      </block>
    </view>

    <view class="orders-head">
      <view class="section-title display" id="orders-section">待处理订单</view>
      <view class="orders-tools">
        <view
          wx:if="{{pendingCount}}"
          class="copy-receipts accept-all {{acceptingAll ? 'disabled' : ''}}"
          bindtap="onAcceptAll"
        >{{acceptingAll ? '接单中…' : '全部接单'}}</view>
        <view
          wx:if="{{acceptedCount}}"
          class="copy-receipts advance {{batchAdvancing ? 'disabled' : ''}}"
          data-status="cooking"
          bindtap="onBatchAdvance"
        >{{batchAdvancing ? '处理中…' : '全部开火'}}</view>
        <view
          wx:if="{{cookingCount}}"
          class="copy-receipts advance {{batchAdvancing ? 'disabled' : ''}}"
          data-status="ready"
          bindtap="onBatchAdvance"
        >{{batchAdvancing ? '处理中…' : '全部出锅'}}</view>
        <view
          wx:if="{{readyCount}}"
          class="copy-receipts advance {{batchAdvancing ? 'disabled' : ''}}"
          data-status="completed"
          bindtap="onBatchAdvance"
        >{{batchAdvancing ? '处理中…' : '全部完成'}}</view>
        <view
          wx:if="{{orders.length}}"
          class="copy-receipts {{copyingReceipts ? 'disabled' : ''}}"
          bindtap="onCopyActiveReceipts"
        >{{copyingReceipts ? '复制中…' : '复制小票'}}</view>
      </view>
    </view>
    <view wx:if="{{orders.length}}" class="order-meals">
      <view
        class="order-meal {{orderMeal === 'all' ? 'active' : ''}}"
        data-meal="all"
        bindtap="onOrderMeal"
      >全部</view>
      <view
        wx:for="{{mealOptions}}"
        wx:key="id"
        class="order-meal {{orderMeal === item.id ? 'active' : ''}}"
        data-meal="{{item.id}}"
        bindtap="onOrderMeal"
      >{{item.name}}</view>
      <view class="order-meal sort-toggle" bindtap="onOrderSort">{{orderSort === 'wait' ? '最久优先' : '最新优先'}}</view>
    </view>
    <view wx:if="{{orders.length}}" class="order-search">
      <text class="order-search-icon">🔍</text>
      <input
        class="order-search-input"
        value="{{orderKeyword}}"
        placeholder="搜单号 / 菜名 / 备注"
        bindinput="onOrderSearch"
      />
      <view wx:if="{{orderKeyword}}" class="order-search-clear" bindtap="onClearOrderSearch">×</view>
    </view>
    <view wx:if="{{!ordersView.length}}" class="empty-line">{{orderKeyword ? '没搜到相关订单' : '暂时没有待处理的订单，歇会儿吧'}}</view>

    <view
      wx:for="{{ordersView}}"
      wx:key="id"
      class="order card {{item.urgent ? 'urgent' : ''}}"
      data-id="{{item.id}}"
      bindtap="onHistoryTap"
    >
      <view class="order-top">
        <text class="no">#{{item.no}}</text>
        <view class="order-top-right">
          <text wx:if="{{item.messageBadge}}" class="message-badge">留言 {{item.messageBadge}}</text>
          <text wx:if="{{item.slotUpdated}}" class="slot-updated">改过时间</text>
          <text wx:if="{{item.waitText}}" class="order-wait">{{item.waitText}}</text>
          <view class="status {{item.status}}">{{item.statusText}}</view>
        </view>
      </view>
      <view class="order-summary">{{item.summary}}</view>
      <view wx:if="{{item.urged}}" class="urge-badge">她催啦{{item.urgeText}}</view>
      <view class="order-meta">{{item.dateText}} · {{item.mealText}} · {{item.mode}} · {{item.expectedTime}} · {{item.timeText}}</view>
      <view class="order-items">
        <view
          wx:for="{{item.itemLines}}"
          wx:for-item="dish"
          wx:key="key"
          class="order-item"
        >
          <view class="oi-main">
            <text class="oi-name">{{dish.name}}</text>
            <view class="oi-right">
              <view
                wx:if="{{dish.hasRecipe}}"
                class="oi-recipe"
                data-id="{{dish.dishId}}"
                catchtap="onViewRecipe"
              >做法</view>
              <text class="oi-qty">×{{dish.qty}}</text>
            </view>
          </view>
          <view wx:if="{{dish.specText}}" class="oi-spec">{{dish.specText}}</view>
          <view wx:if="{{dish.note}}" class="oi-note">备注：{{dish.note}}</view>
        </view>
      </view>
      <view wx:if="{{item.profileText}}" class="order-taste">{{item.profileText}}</view>
      <view wx:if="{{item.allergyText}}" class="order-allergy">⚠️ 含过敏原：{{item.allergyText}}</view>
      <view wx:if="{{item.address}}" class="order-address">送到：{{item.address}}</view>
      <view wx:if="{{item.note}}" class="order-note">整单备注：{{item.note}}<text wx:if="{{item.noteUpdated}}" class="note-updated"> · 刚改过</text></view>
      <view wx:if="{{item.lastMessageText}}" class="order-last-message">💬 {{item.lastMessageText}}</view>
      <view class="order-actions">
        <view class="kbtn ghost" data-id="{{item.id}}" catchtap="onOpenReceipt">小票</view>
        <view
          wx:if="{{item.status === 'pending'}}"
          class="kbtn ghost {{busyId === item.id ? 'busy' : ''}}"
          data-id="{{item.id}}"
          catchtap="onReject"
        >{{busyId === item.id ? '处理中…' : '拒单'}}</view>
        <view
          class="kbtn primary {{busyId === item.id ? 'busy' : ''}}"
          data-id="{{item.id}}"
          data-status="{{item.status}}"
          catchtap="onAdvance"
        >{{busyId === item.id ? '处理中…' : item.actionLabel}}</view>
      </view>
    </view>

    <view class="history-head" id="history-section" bindtap="onToggleHistory">
      <view class="section-title display">历史订单</view>
      <view class="history-head-right">
        <view
          wx:if="{{showHistory && history.length > 10}}"
          class="history-all"
          catchtap="onToggleHistoryAll"
        >{{historyAll ? '收起' : '看全部'}}</view>
        <view class="history-toggle">{{showHistory ? '收起' : '看最近 10 单'}}<text wx:if="{{todo.replies}}" class="history-reply-badge">{{todo.replies}} 待回复</text></view>
      </view>
    </view>
    <block wx:if="{{showHistory}}">
      <view class="history-search">
        <text class="history-search-icon">🔍</text>
        <input
          class="history-search-input"
          placeholder="搜单号 / 菜名 / 备注"
          value="{{historyKeyword}}"
          bindinput="onHistorySearch"
        />
        <view wx:if="{{historyKeyword}}" class="history-search-clear" bindtap="onClearHistorySearch">×</view>
      </view>
      <view class="history-filter">
        <view class="history-chip {{!historyOnlyPending ? 'active' : ''}}" data-only="all" bindtap="onHistoryFilter">全部</view>
        <view class="history-chip {{historyOnlyPending ? 'active' : ''}}" data-only="pending" bindtap="onHistoryFilter">待回复 {{todo.replies}}</view>
      </view>
      <view class="history-filter range">
        <view class="history-chip {{historyMeal === 'all' ? 'active' : ''}}" data-meal="all" bindtap="onHistoryMeal">全部餐次</view>
        <view class="history-chip {{historyMeal === 'breakfast' ? 'active' : ''}}" data-meal="breakfast" bindtap="onHistoryMeal">早餐</view>
        <view class="history-chip {{historyMeal === 'lunch' ? 'active' : ''}}" data-meal="lunch" bindtap="onHistoryMeal">午餐</view>
        <view class="history-chip {{historyMeal === 'dinner' ? 'active' : ''}}" data-meal="dinner" bindtap="onHistoryMeal">晚餐</view>
      </view>
      <view class="history-filter range">
        <view class="history-chip {{historyRange === 'today' ? 'active' : ''}}" data-range="today" bindtap="onHistoryRange">今天</view>
        <view class="history-chip {{historyRange === 'week' ? 'active' : ''}}" data-range="week" bindtap="onHistoryRange">近 7 天</view>
        <view class="history-chip {{historyRange === 'all' ? 'active' : ''}}" data-range="all" bindtap="onHistoryRange">不限日期</view>
      </view>
      <view class="history-filter range">
        <view class="history-chip {{historyRating === 'all' ? 'active' : ''}}" data-rating="all" bindtap="onHistoryRating">全部评分</view>
        <view class="history-chip {{historyRating === 'good' ? 'active' : ''}}" data-rating="good" bindtap="onHistoryRating">好评</view>
        <view class="history-chip {{historyRating === 'neutral' ? 'active' : ''}}" data-rating="neutral" bindtap="onHistoryRating">一般</view>
        <view class="history-chip {{historyRating === 'bad' ? 'active' : ''}}" data-rating="bad" bindtap="onHistoryRating">翻车</view>
      </view>
      <view wx:if="{{historyTags.length}}" class="history-filter range">
        <view class="history-chip {{historyTag === 'all' ? 'active' : ''}}" data-tag="all" bindtap="onHistoryTag">全部标签</view>
        <view
          wx:for="{{historyTags}}"
          wx:key="name"
          class="history-chip {{historyTag === item.name ? 'active' : ''}}"
          data-tag="{{item.name}}"
          bindtap="onHistoryTag"
        >{{item.name}} {{item.count}}</view>
      </view>
      <view class="history-csv" bindtap="onCopyHistoryCsv">复制筛选 CSV</view>
      <view wx:if="{{!historyView.length}}" class="empty-line">{{historyEmptyText}}</view>
      <view
        wx:for="{{historyView}}"
        wx:key="id"
        class="order card history-order"
        data-id="{{item.id}}"
        bindtap="onHistoryTap"
      >
        <view class="order-top">
          <text class="no">#{{item.no}}</text>
          <view class="order-top-right">
            <text wx:if="{{item.messageBadge}}" class="message-badge">留言 {{item.messageBadge}}</text>
            <text wx:if="{{item.ratingText}}" class="rating-badge">{{item.ratingText}}</text>
            <text wx:if="{{item.ownerReply}}" class="replied-badge">已回复</text>
            <view class="status {{item.status}}">{{item.statusText}}</view>
          </view>
        </view>
        <view class="order-summary">{{item.summary}}</view>
        <view wx:if="{{item.allergyText}}" class="order-allergy">⚠️ 含过敏原：{{item.allergyText}}</view>
        <view wx:if="{{item.status === 'cancelled' && item.cancelReason}}" class="order-cancel-reason">取消原因：{{item.cancelReason}}</view>
        <view wx:if="{{item.ratingTags.length}}" class="order-rating-tags">
          <text wx:for="{{item.ratingTags}}" wx:for-item="tag" wx:key="*this" class="order-rating-tag">{{tag}}</text>
        </view>
        <view wx:if="{{item.ratingImages.length}}" class="order-rating-images">
          <image
            wx:for="{{item.ratingImages}}"
            wx:for-item="src"
            wx:key="*this"
            class="order-rating-image"
            src="{{src}}"
            mode="aspectFill"
            lazy-load
            data-src="{{src}}"
            data-id="{{item.id}}"
            catchtap="onPreviewOrderImages"
          />
        </view>
        <view wx:if="{{item.feedback}}" class="order-feedback">“{{item.feedback}}”</view>
        <view wx:if="{{item.ownerReply}}" class="order-reply">
          <text class="order-reply-label">掌勺人</text>
          <text class="order-reply-text">{{item.ownerReply}}</text>
        </view>
        <view class="order-meta">{{item.dateText}} · {{item.mealText}} · {{item.timeText}}</view>
        <view class="history-actions">
          <view class="kbtn ghost" data-id="{{item.id}}" catchtap="onOpenReceipt">小票</view>
          <view
            wx:if="{{item.canReply}}"
            class="kbtn ghost {{replyingId === item.id ? 'busy' : ''}}"
            data-id="{{item.id}}"
            catchtap="onReplyRating"
          >{{replyingId === item.id ? '回复中…' : (item.ownerReply ? '改一句回复' : '回复评价')}}</view>
        </view>
      </view>
    </block>

    <view class="menu-head" id="menu-section">
      <view class="section-title display menu-title">菜品管理</view>
      <view class="menu-actions">
        <view class="add-dish ghost" bindtap="onTemplates">模板</view>
        <view class="add-dish ghost" bindtap="onCategories">分类</view>
        <view class="add-dish ghost {{batchBusy ? 'disabled' : ''}}" bindtap="onBatchStatus">{{batchBusy ? '处理中' : '批量'}}</view>
        <view class="add-dish" bindtap="onAddDish">+ 新增</view>
      </view>
    </view>
    <view class="dish-search">
      <text class="dish-search-icon">🔍</text>
      <input
        class="dish-search-input"
        value="{{dishKeyword}}"
        placeholder="搜菜名 / 描述"
        bindinput="onDishSearch"
      />
      <view wx:if="{{dishKeyword}}" class="dish-search-clear" bindtap="onClearDishSearch">×</view>
    </view>
    <view wx:if="{{dishCategoryOptions.length > 1}}" class="dish-filter-row">
      <view
        wx:for="{{dishCategoryOptions}}"
        wx:key="id"
        class="dish-filter {{dishCategory === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onDishCategory"
      >{{item.name}}</view>
    </view>
    <view class="dish-filter-row">
      <view
        wx:for="{{dishFilters}}"
        wx:key="key"
        class="dish-filter {{dishFilter === item.key ? 'active' : ''}}"
        data-filter="{{item.key}}"
        bindtap="onDishFilter"
      >{{item.label}} {{item.count}}</view>
    </view>
    <view wx:if="{{!displayDishes.length}}" class="empty-line">没有符合条件的菜</view>
    <view class="menu card">
      <view
        wx:for="{{displayDishes}}"
        wx:key="id"
        class="dish-row"
        data-id="{{item.id}}"
        bindtap="onEditDish"
      >
        <view class="dish-dot" style="background: {{item.color}};">{{item.emoji || item.char}}</view>
        <view class="dish-info">
          <view class="dish-name">{{item.name}}</view>
          <view class="dish-price {{item.stock >= 0 && item.stock <= lowStockThreshold ? 'low' : ''}}">¥{{item.price}}<text wx:if="{{item.stock >= 0}}"> · 剩 {{item.stock}} 份</text><text wx:if="{{!item.recipe}}" class="missing-recipe"> · 缺做法</text></view>
        </view>
        <view
          wx:if="{{item.stock >= 0 && item.stock <= lowStockThreshold}}"
          class="restock-btn {{restockingId === item.id ? 'busy' : ''}}"
          data-id="{{item.id}}"
          catchtap="onRestock"
        >{{restockingId === item.id ? '补…' : '补5'}}</view>
        <view class="dish-move">
          <view class="move-btn {{movingId === item.id ? 'busy' : ''}}" data-id="{{item.id}}" data-direction="up" catchtap="onMoveDish">↑</view>
          <view class="move-btn {{movingId === item.id ? 'busy' : ''}}" data-id="{{item.id}}" data-direction="down" catchtap="onMoveDish">↓</view>
        </view>
        <view
          class="dish-toggle {{item.status !== 'on' ? 'off' : ''}} {{item.status === 'off' ? 'hidden' : ''}} {{busyDishId === item.id ? 'busy' : ''}}"
          data-id="{{item.id}}"
          catchtap="onToggleDish"
        >{{item.status === 'off' ? '已下架' : (item.status === 'soldout' ? '已售罄' : '供应中')}}</view>
      </view>
    </view>
  </block>

  <view wx:if="{{receiptVisible && receipt}}" class="receipt-mask" catchtap="onCloseReceipt">
    <view class="receipt-sheet" catchtap="onNoopReceipt">
      <view class="receipt-head">
        <view>
          <view class="receipt-title">订单小票</view>
          <view class="receipt-sub">#{{receipt.no}} · {{receipt.dateText}} · {{receipt.mealText}}</view>
        </view>
        <view class="receipt-close" catchtap="onCloseReceipt">×</view>
      </view>
      <view class="receipt-brand">张饱饭堂</view>
      <view class="receipt-meta">{{receipt.mode}} · {{receipt.expectedTime}} · {{receipt.timeText}}</view>
      <view class="receipt-dash"></view>
      <view wx:for="{{receiptLines}}" wx:key="key" class="receipt-line">
        <view class="receipt-line-main">
          <text class="receipt-name">{{item.name}} ×{{item.qty}}</text>
          <text class="receipt-price">¥{{item.lineTotal}}</text>
        </view>
        <view wx:if="{{item.specText}}" class="receipt-note">规格：{{item.specText}}</view>
        <view wx:if="{{item.allergenText}}" class="receipt-note">含：{{item.allergenText}}</view>
        <view wx:if="{{item.note}}" class="receipt-note">备注：{{item.note}}</view>
      </view>
      <view class="receipt-dash"></view>
      <view class="receipt-total">
        <text>合计</text>
        <text>¥{{receipt.amount}}</text>
      </view>
      <view class="receipt-foot">共 {{receipt.totalQty}} 份<text wx:if="{{receipt.profileText}}"> · {{receipt.profileText}}</text></view>
      <view wx:if="{{receipt.address}}" class="receipt-note">送到：{{receipt.address}}</view>
      <view wx:if="{{receipt.note}}" class="receipt-note">整单备注：{{receipt.note}}</view>
      <view class="receipt-actions">
        <view class="kbtn primary" catchtap="onCopyReceipt">复制小票</view>
        <view class="kbtn ghost" catchtap="onCloseReceipt">关上</view>
      </view>
    </view>
  </view>
  <canvas type="2d" id="dailyPoster" class="daily-poster-canvas"></canvas>
  <canvas type="2d" id="prepPoster" class="prep-poster-canvas"></canvas>
</view>
