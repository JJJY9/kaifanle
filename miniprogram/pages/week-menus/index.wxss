.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 200rpx;
}

.head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sticker {
  padding: 2rpx 12rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 10rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 20rpx;
  font-weight: 800;
  transform: rotate(4deg);
}

.edit-link {
  padding: 8rpx 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 22rpx;
  font-weight: 800;
}

.edit-link:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.sub {
  margin-top: 8rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.sk-card {
  height: 320rpx;
  margin-bottom: 26rpx;
  border-radius: 40rpx;
}

.day-card {
  padding: 24rpx;
  margin-bottom: 26rpx;
}

.day-card.today {
  box-shadow: 8rpx 8rpx 0 #FF6B35;
}

.day-card.closed {
  background: #EFE9DC;
  border-style: dashed;
  box-shadow: none;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-date {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.day-num {
  min-width: 64rpx;
  font-size: 62rpx;
  font-weight: 800;
  line-height: 1;
}

.day-date-info {
  display: flex;
  flex-direction: column;
}

.day-week {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.3;
}

.day-month {
  color: #5C5C5C;
  font-size: 21rpx;
  line-height: 1.3;
}

.day-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tag {
  padding: 4rpx 16rpx;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.today-tag {
  background: #FFD23F;
  transform: rotate(-3deg);
}

.soon-tag {
  background: #2D9CFF;
  color: #FFFFFF;
}

.rest-tag {
  background: #B8B8B8;
  color: #FFFFFF;
}

.closed-note {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 3rpx dashed rgba(17, 17, 17, 0.2);
  color: #5C5C5C;
  font-size: 24rpx;
  font-weight: 700;
}

.meal-list {
  margin-top: 12rpx;
}

.meal-row {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 3rpx dashed rgba(17, 17, 17, 0.15);
}

.meal-row:last-child {
  padding-bottom: 4rpx;
  border-bottom: none;
}

.meal-row.now {
  margin: 0 -12rpx;
  padding: 18rpx 12rpx;
  background: #FFF7DA;
  border-radius: 18rpx;
}

.meal-name {
  display: flex;
  flex: 0 0 84rpx;
  flex-direction: column;
  padding-top: 2rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.now-tag {
  margin-top: 2rpx;
  color: #FF6B35;
  font-size: 18rpx;
  font-weight: 800;
}

.meal-body {
  flex: 1;
  min-width: 0;
}

.meal-top {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.meal-state {
  padding: 2rpx 14rpx;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.4;
}

.meal-state.ready {
  background: #2FBF71;
  color: #FFFFFF;
}

.meal-state.empty {
  background: #EFE9DC;
  color: #5C5C5C;
}

.meal-state.zero,
.meal-state.unavailable {
  background: #FFD23F;
}

.meal-state.unopened {
  background: #FF5C8A;
  color: #FFFFFF;
}

.meal-state.off {
  background: #E8E8E8;
  color: #B8B8B8;
}

.meal-state.cutoff {
  background: #FF6B35;
  color: #FFFFFF;
}

.meal-hint {
  min-width: 0;
  color: #5C5C5C;
  font-size: 20rpx;
}

.meal-booked {
  padding: 2rpx 12rpx;
  background: #2D9CFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.4;
}

.meal-row.now .meal-hint {
  color: #7A5A00;
}

.dish-chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.dish-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  max-width: 100%;
  padding: 4rpx 12rpx;
  background: #FFFDF6;
  border: 3rpx solid #111111;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.dish-icon {
  font-size: 18rpx;
  line-height: 1;
}

.dish-name {
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-chip.soldout {
  opacity: 0.45;
  text-decoration: line-through;
}

.more-chip {
  padding: 4rpx 10rpx;
  background: #EFE9DC;
  border-radius: 10rpx;
  color: #5C5C5C;
  font-size: 20rpx;
  font-weight: 800;
}

.book-btn {
  flex: 0 0 auto;
  align-self: center;
  padding: 8rpx 16rpx;
  background: #FF6B35;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 20rpx;
  font-weight: 800;
}

.book-btn:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.book-btn.booked {
  background: #E9F1FF;
  color: #2D6FD9;
}

.foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
}

.foot-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: #FF6B35;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 7rpx 7rpx 0 #111111;
  font-size: 32rpx;
  font-weight: 800;
}

.foot-btn:active {
  transform: translate(7rpx, 7rpx);
  box-shadow: none;
}

.foot-btn.share {
  margin-top: 14rpx;
  background: #FFFFFF;
  font-size: 26rpx;
}

button.foot-btn {
  width: 100%;
  padding: 0;
  line-height: normal;
}

.foot-link {
  padding: 10rpx 20rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  font-weight: 800;
}
