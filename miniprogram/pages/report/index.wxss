.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
}

.head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sticker {
  padding: 2rpx 12rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 10rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 20rpx;
  font-weight: 800;
  transform: rotate(4deg);
}

.sub {
  margin-top: 8rpx;
  color: #5C5C5C;
  font-size: 23rpx;
}

.range-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.range-chip {
  padding: 8rpx 22rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.range-chip.active {
  background: #FFD23F;
}

.sk-card {
  height: 240rpx;
  margin-bottom: 24rpx;
  border-radius: 40rpx;
}

.stats-card {
  display: flex;
  align-items: stretch;
  padding: 24rpx 10rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.stat-num {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
}

.stat-label {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 20rpx;
}

.divider {
  width: 3rpx;
  background: rgba(17, 17, 17, 0.15);
  border-radius: 999rpx;
}

.rating-line {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.month-goal-card {
  margin-top: 20rpx;
  padding: 22rpx;
}

.month-goal-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.month-goal-title {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 26rpx;
  font-weight: 800;
}

.month-goal-amount {
  color: #5C5C5C;
  font-size: 22rpx;
}

.month-goal-track {
  height: 20rpx;
  margin-top: 14rpx;
  overflow: hidden;
  background: #EFE9DC;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
}

.month-goal-fill {
  height: 100%;
  background: #2D9CFF;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.month-goal-text {
  margin-top: 8rpx;
  color: #5C5C5C;
  font-size: 22rpx;
}

.cost-card {
  margin-top: 20rpx;
  padding: 22rpx;
}

.cost-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.cost-title {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 28rpx;
  font-weight: 800;
}

.cost-sub {
  color: #5C5C5C;
  font-size: 21rpx;
}

.cost-grid {
  display: flex;
}

.cost-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cost-num {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 30rpx;
  font-weight: 800;
}

.cost-label {
  margin-top: 2rpx;
  color: #5C5C5C;
  font-size: 20rpx;
}

.compare {
  margin-top: 18rpx;
  padding: 20rpx;
}

.compare-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.compare-title {
  font-size: 26rpx;
  font-weight: 800;
}

.compare-badge {
  padding: 4rpx 14rpx;
  background: #F0F0F0;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.compare-badge.up {
  background: #2FBF71;
}

.compare-badge.down {
  background: #FFB3C7;
}

.compare-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
}

.compare-label {
  color: #5C5C5C;
  font-size: 22rpx;
}

.compare-value {
  font-size: 26rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.compare-prev {
  color: #5C5C5C;
  font-size: 20rpx;
  font-weight: 600;
}

.tags-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
}

.tags-title {
  color: #5C5C5C;
  font-size: 21rpx;
  font-weight: 700;
}

.meal-stats {
  display: flex;
  align-items: stretch;
  margin-top: 18rpx;
  padding: 18rpx 10rpx;
}

.meal-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  border-right: 2rpx dashed #E0E0E0;
}

.meal-stat:last-child {
  border-right: none;
}

.meal-stat-name {
  color: #5C5C5C;
  font-size: 21rpx;
  font-weight: 700;
}

.meal-stat-revenue {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 32rpx;
  font-weight: 800;
}

.meal-stat-count {
  color: #9A9A9A;
  font-size: 19rpx;
}

.category-stats {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
}

.compare-sub {
  color: #8C8C8C;
  font-size: 20rpx;
}

.category-sort {
  display: flex;
  gap: 8rpx;
}

.category-sort-item {
  padding: 4rpx 14rpx;
  background: #EFE9DC;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  color: #5C5C5C;
  font-size: 19rpx;
  font-weight: 800;
}

.category-sort-item.active {
  background: #FFD23F;
  color: #111111;
}

.category-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 0;
  border-bottom: 2rpx dashed rgba(17, 17, 17, 0.1);
}

.category-row:last-child {
  border-bottom: none;
}

.category-name-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.category-name {
  font-size: 24rpx;
  font-weight: 700;
}

.category-profit {
  color: #2F7D4F;
  font-size: 18rpx;
  font-weight: 700;
}

.category-qty {
  color: #5C5C5C;
  font-size: 21rpx;
}

.category-revenue {
  min-width: 120rpx;
  text-align: right;
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 26rpx;
  font-weight: 800;
}

.report-tag {
  padding: 4rpx 14rpx;
  background: #E8F8EE;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.health-card {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
}

.health-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.health-title {
  font-size: 26rpx;
  font-weight: 800;
}

.health-sub {
  color: #5C5C5C;
  font-size: 20rpx;
}

.health-row {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.health-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 4rpx;
  background: #EFE9DC;
  border-radius: 14rpx;
}

.health-item.warn {
  background: #FFF7DA;
}

.health-num {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 30rpx;
  font-weight: 800;
}

.health-label {
  color: #5C5C5C;
  font-size: 18rpx;
}

.health-item.jump:active {
  transform: translateY(2rpx);
  opacity: 0.8;
}

.health-note {
  margin-top: 12rpx;
  padding: 10rpx 14rpx;
  background: #FFF7DA;
  border-radius: 12rpx;
  color: #5C5C5C;
  font-size: 20rpx;
  font-weight: 700;
}

.export-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin-top: 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 24rpx;
  font-weight: 800;
}

.export-btn:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: none;
}

.export-btn.disabled {
  opacity: 0.6;
}

.export-hint {
  margin-top: 8rpx;
  color: #5C5C5C;
  font-size: 20rpx;
  text-align: center;
}

.chart {
  margin-top: 20rpx;
  padding: 20rpx;
}

.chart-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.chart-title {
  font-size: 27rpx;
  font-weight: 800;
}

.chart-total {
  color: #5C5C5C;
  font-size: 21rpx;
  font-weight: 700;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 240rpx;
  margin-top: 16rpx;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  min-width: 0;
}

.chart-bar-wrap {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  width: 100%;
  height: 190rpx;
}

.chart-bar {
  width: 100%;
  background: #FF6B35;
  border-radius: 6rpx 6rpx 0 0;
}

.chart-bar.empty {
  background: #E8E8E8;
}

.chart-label {
  margin-top: 6rpx;
  color: #5C5C5C;
  font-size: 16rpx;
  line-height: 1;
  white-space: nowrap;
}

.dish-export-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin: 4rpx 0 24rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.section-title {
  margin: 28rpx 4rpx 14rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-line {
  padding: 24rpx 0;
  color: #5C5C5C;
  font-size: 24rpx;
  text-align: center;
}

.dish-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}

.dish-row:active {
  transform: translateY(2rpx);
  opacity: 0.85;
}

.rank {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  background: #EFE9DC;
  border: 3rpx solid #111111;
  border-radius: 12rpx;
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 24rpx;
  font-weight: 800;
}

.rank.top {
  background: #FFD23F;
  transform: rotate(-3deg);
}

.rank.slow {
  background: #E5F0FF;
}

.slow-toggle {
  flex: 0 0 auto;
  padding: 8rpx 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.slow-toggle.restore {
  background: #DDF6E8;
}

.slow-toggle.busy {
  opacity: 0.5;
}

.dish-info {
  flex: 0 0 250rpx;
  min-width: 0;
}

.dish-name {
  font-size: 26rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-sub {
  margin-top: 2rpx;
  color: #5C5C5C;
  font-size: 20rpx;
}

.dish-bar-wrap {
  flex: 1;
  height: 20rpx;
  background: #EFE9DC;
  border-radius: 999rpx;
  overflow: hidden;
}

.dish-bar {
  height: 100%;
  background: #2D9CFF;
  border-radius: 999rpx;
}

.foot-note {
  margin-top: 20rpx;
  color: #5C5C5C;
  font-size: 21rpx;
  text-align: center;
}

.category-poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 900px;
  pointer-events: none;
}

.range-chip.copy {
  margin-left: auto;
  background: #FFD23F;
  box-shadow: 2rpx 2rpx 0 #111111;
}
