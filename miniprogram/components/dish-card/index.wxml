<view
  wx:if="{{dish}}"
  class="dish {{dish.status === 'soldout' || dish.stock === 0 ? 'is-soldout' : ''}}"
  bindtap="onTap"
>
  <view class="media" style="background: {{dish.color}};">
    <image wx:if="{{dish.image || dish.cartoon}}" class="media-img" src="{{dish.image || dish.cartoon}}" mode="aspectFill" />
    <text wx:else class="media-char">{{dish.emoji || dish.char}}</text>
    <view wx:if="{{dish.tags[0] && dish.status !== 'soldout' && dish.stock !== 0}}" class="media-tag">{{dish.tags[0]}}</view>
    <view wx:if="{{dish.status === 'soldout' || dish.stock === 0}}" class="soldout-mask">
      <text class="soldout-text">售罄</text>
    </view>
  </view>

  <view class="body">
    <view class="name-row">
      <view class="name">{{dish.name}}</view>
      <view
        wx:if="{{dish.recipe}}"
        class="recipe-pill"
        catchtap="onRecipe"
      >做法</view>
    </view>
    <view class="desc">{{dish.desc}}</view>
    <view wx:if="{{dish.stock >= 0 && dish.stock > 0 && dish.stock <= 5}}" class="stock-hint">仅剩 {{dish.stock}} 份</view>
    <view class="foot">
      <view class="price-wrap">
        <text class="currency">¥</text>
        <text class="price">{{dish.price}}</text>
      </view>
      <view
        wx:if="{{showAdd && dish.status !== 'soldout' && dish.stock !== 0}}"
        class="add"
        catchtap="onAdd"
      >+</view>
      <text wx:elif="{{dish.status === 'soldout' || dish.stock === 0}}" class="soldout-hint">明天赶早</text>
    </view>
  </view>
</view>
