.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
}

.block {
  padding: 26rpx;
  margin-bottom: 24rpx;
}

.block-title {
  margin-bottom: 20rpx;
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 34rpx;
  font-weight: 800;
}

.field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 3rpx dashed rgba(17, 17, 17, 0.12);
}

.field:last-child {
  border-bottom: none;
}

.field-column {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.label {
  flex: 0 0 110rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.input {
  flex: 1;
  height: 72rpx;
  padding: 0 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  font-size: 26rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 8rpx 24rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.chip.active {
  background: #FFD23F;
  box-shadow: 3rpx 3rpx 0 #111111;
  transform: rotate(-1deg);
}

.addon-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.addon-name {
  flex: 1;
  height: 72rpx;
  padding: 0 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  font-size: 26rpx;
}

.addon-price {
  width: 130rpx;
  height: 72rpx;
  padding: 0 14rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  font-size: 26rpx;
}

.remove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid #111111;
  border-radius: 50%;
  font-size: 30rpx;
  line-height: 1;
}

.add-row {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border: 3rpx dashed #111111;
  border-radius: 20rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  font-weight: 700;
}

.colors {
  display: flex;
  gap: 20rpx;
}

.image-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.image-preview {
  position: relative;
  width: 164rpx;
  height: 164rpx;
  border: 3rpx solid #111111;
  border-radius: 22rpx;
  overflow: hidden;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  background: #FFFFFF;
  border: 2rpx solid #111111;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 164rpx;
  height: 164rpx;
  background: #FFFDF6;
  border: 3rpx dashed #111111;
  border-radius: 22rpx;
}

.image-plus {
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1;
}

.image-hint {
  color: #5C5C5C;
  font-size: 20rpx;
}

.image-replace {
  padding: 10rpx 26rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 23rpx;
  font-weight: 800;
}

.image-replace:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.image-tip {
  color: #8A8A8A;
  font-size: 20rpx;
}

.color-dot {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid #111111;
  border-radius: 50%;
}

.color-dot.active {
  box-shadow: 4rpx 4rpx 0 #111111;
  transform: scale(1.05);
}

.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin-top: 10rpx;
  background: #FF6B35;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 7rpx 7rpx 0 #111111;
  font-size: 32rpx;
  font-weight: 800;
}

.save-btn:active {
  transform: translate(7rpx, 7rpx);
  box-shadow: none;
}

.save-btn.disabled {
  opacity: 0.6;
}

.delete-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin-top: 24rpx;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  color: #D9431C;
  font-size: 26rpx;
  font-weight: 800;
}

.delete-btn.disabled {
  opacity: 0.5;
}

.sk {
  height: 800rpx;
}
