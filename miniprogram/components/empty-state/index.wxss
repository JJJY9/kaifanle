.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx;
}

.face {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  background: #FFD23F;
  border: 4rpx solid #111111;
  border-radius: 50%;
  box-shadow: 8rpx 8rpx 0 #111111;
  transform: rotate(-4deg);
}

.eye {
  position: absolute;
  top: 62rpx;
  width: 14rpx;
  height: 14rpx;
  background: #111111;
  border-radius: 50%;
}

.eye.left {
  left: 48rpx;
}

.eye.right {
  right: 48rpx;
}

.blush {
  position: absolute;
  top: 84rpx;
  width: 26rpx;
  height: 14rpx;
  background: #FF5C8A;
  border-radius: 999rpx;
  opacity: 0.8;
}

.blush.left {
  left: 26rpx;
}

.blush.right {
  right: 26rpx;
}

.mouth {
  position: absolute;
  left: 50%;
  bottom: 44rpx;
  width: 42rpx;
  height: 6rpx;
  margin-left: -21rpx;
  background: #111111;
  border-radius: 999rpx;
}

.title {
  margin-top: 36rpx;
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 40rpx;
  font-weight: 800;
}

.desc {
  margin-top: 8rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  text-align: center;
}

.action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  margin-top: 32rpx;
  padding: 0 44rpx;
  background: #FF6B35;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 6rpx 6rpx 0 #111111;
  font-size: 28rpx;
  font-weight: 800;
}

.action:active {
  transform: translate(6rpx, 6rpx);
  box-shadow: none;
}
