.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
}

.head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx 8rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sub {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.notify-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.notify-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 28rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 24rpx;
  font-weight: 800;
}

.notify-btn:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: none;
}

.notify-btn.settings {
  background: #2D9CFF;
  color: #FFFFFF;
}

.notify-btn.menu {
  background: #FF5C8A;
}

.notify-btn.week {
  background: #FFFFFF;
}

.notify-btn.report {
  background: #EFE9DC;
}

.notify-btn.copy {
  background: #2FBF71;
}

.notify-btn.rest {
  background: #FFB3C7;
}

.notify-btn.rest.closed {
  background: #2FBF71;
  color: #FFFFFF;
}

.notify-hint {
  color: #5C5C5C;
  font-size: 22rpx;
}

.stats-card {
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
  padding: 22rpx 12rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.stat-num {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.1;
}

.stat-top {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.5;
  text-align: center;
}

.stat-label {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 21rpx;
}

.goal-card {
  margin-top: 20rpx;
  padding: 20rpx;
}

.goal-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.goal-title {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 26rpx;
  font-weight: 800;
}

.goal-amount {
  color: #5C5C5C;
  font-size: 22rpx;
}

.goal-track {
  height: 20rpx;
  margin-top: 14rpx;
  overflow: hidden;
  background: #EFE9DC;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
}

.goal-fill {
  height: 100%;
  background: #2FBF71;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.goal-text {
  margin-top: 8rpx;
  color: #5C5C5C;
  font-size: 22rpx;
}

.special-card {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #FFF1F6;
}

.special-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.special-title {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 28rpx;
  font-weight: 800;
}

.special-sub {
  color: #8A5A68;
  font-size: 21rpx;
}

.special-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-top: 2rpx dashed rgba(17, 17, 17, 0.12);
  font-size: 24rpx;
}

.special-row.urgent .special-days {
  color: #FF5C8A;
}

.special-emoji {
  font-size: 28rpx;
}

.special-label {
  font-weight: 800;
}

.special-date {
  color: #5C5C5C;
  font-size: 22rpx;
}

.special-days {
  margin-left: auto;
  font-weight: 800;
}

.special-more {
  margin-top: 8rpx;
  color: #8A5A68;
  font-size: 21rpx;
}

.special-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 20rpx;
}

.special-error-text {
  color: #5C5C5C;
  font-size: 23rpx;
}

.special-retry {
  padding: 8rpx 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.todo-card {
  margin-top: 20rpx;
  padding: 20rpx;
}

.todo-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.todo-title {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 30rpx;
  font-weight: 800;
}

.todo-sub {
  color: #5C5C5C;
  font-size: 20rpx;
}

.todo-head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.todo-restock {
  padding: 6rpx 16rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 20rpx;
  font-weight: 800;
}

.todo-restock:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.todo-restock.busy {
  opacity: 0.6;
}

.todo-row {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.todo-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 8rpx;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
}

.todo-item.pending {
  background: #FFD23F;
}

.todo-item.replies {
  background: #FF5C8A;
  color: #FFFFFF;
}

.todo-item.stock {
  background: #2D9CFF;
  color: #FFFFFF;
}

.todo-item.preorders {
  background: #2FBF71;
  color: #FFFFFF;
}

.todo-item:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.todo-num {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.1;
}

.todo-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.week-line {
  margin: 12rpx 6rpx 0;
  color: #5C5C5C;
  font-size: 22rpx;
  font-weight: 700;
}

.summary-copy {
  margin: 10rpx 6rpx 0;
  color: #2D9CFF;
  font-size: 21rpx;
  font-weight: 800;
}

.summary-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.daily-poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 800px;
  pointer-events: none;
}

.prep-poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 900px;
  pointer-events: none;
}

.chart {
  margin-top: 20rpx;
  padding: 20rpx 24rpx 16rpx;
}

.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chart-title {
  font-size: 26rpx;
  font-weight: 800;
}

.chart-total {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 32rpx;
  font-weight: 800;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.chart-bar-wrap {
  display: flex;
  align-items: flex-end;
  width: 100%;
  height: 140rpx;
}

.chart-bar {
  width: 100%;
  min-height: 8rpx;
  background: #FF6B35;
  border: 3rpx solid #111111;
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}

.chart-bar.empty {
  background: #EFE9DC;
}

.chart-label {
  margin-top: 8rpx;
  color: #5C5C5C;
  font-size: 20rpx;
  font-weight: 700;
}

.prep {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
}

.prep-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.prep-title {
  font-size: 28rpx;
  font-weight: 800;
}

.prep-copy {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  margin-top: 12rpx;
  background: #EFE9DC;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.prep-copy:active {
  transform: translate(2rpx, 2rpx);
}

.prep-sub {
  margin-top: 2rpx;
  color: #5C5C5C;
  font-size: 21rpx;
}

.prep-badge {
  padding: 6rpx 20rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.prep-group {
  margin-top: 14rpx;
}

.prep-ingredients {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 3rpx dashed rgba(17, 17, 17, 0.2);
}

.prep-ingredients-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.prep-done-count {
  color: #2F7D4F;
  font-size: 21rpx;
}

.prep-ingredient-row {
  justify-content: flex-start;
  gap: 12rpx;
}

.prep-ingredient-row .prep-name {
  flex: 1;
  min-width: 0;
}

.prep-check {
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.prep-ingredient-row.done .prep-check {
  background: #2FBF71;
  color: #FFFFFF;
}

.prep-ingredient-row.done .prep-name {
  color: #9A9A9A;
  text-decoration: line-through;
}

.prep-ingredient-amount {
  color: #2D6FD9;
  font-size: 24rpx;
  font-weight: 800;
}

.prep-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.prep-group-title {
  margin-bottom: 4rpx;
  color: #5C5C5C;
  font-size: 21rpx;
  font-weight: 800;
}

.prep-allergy {
  color: #8A2D4A;
  font-weight: 800;
}

.prep-group-copy {
  margin-bottom: 4rpx;
  padding: 2rpx 12rpx;
  background: #FFF7DA;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.prep-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 3rpx dashed rgba(17, 17, 17, 0.12);
}

.prep-row:last-child {
  border-bottom: none;
}

.prep-name {
  font-size: 26rpx;
  font-weight: 700;
}

.prep-qty {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 28rpx;
  font-weight: 800;
}

.section-title {
  margin: 30rpx 4rpx 18rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.menu-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 44rpx 4rpx 18rpx;
}

.menu-head .menu-title {
  margin: 0;
}

.menu-actions {
  display: flex;
  gap: 12rpx;
}

.add-dish {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 24rpx;
  background: #FF6B35;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 24rpx;
  font-weight: 800;
}

.add-dish.ghost {
  background: #FFFFFF;
  box-shadow: none;
}

.add-dish.disabled {
  opacity: 0.5;
}

.add-dish:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: none;
}

.empty-line {
  padding: 28rpx;
  background: #FFFFFF;
  border: 3rpx dashed #111111;
  border-radius: 24rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  text-align: center;
}

.order {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.order.urgent {
  border-color: #D9431C;
  box-shadow: 6rpx 6rpx 0 #D9431C;
}

.order.urgent .order-wait {
  background: #D9431C;
  border-color: #D9431C;
  color: #FFFFFF;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.no {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 30rpx;
  font-weight: 800;
  color: #5C5C5C;
}

.order-top-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-wait {
  padding: 4rpx 16rpx;
  background: #FFFDF6;
  border: 3rpx dashed #D9431C;
  border-radius: 999rpx;
  color: #D9431C;
  font-size: 20rpx;
  font-weight: 800;
}

.slot-updated {
  padding: 4rpx 14rpx;
  background: #E9F1FF;
  border: 3rpx solid #2D6FD9;
  border-radius: 999rpx;
  color: #2D6FD9;
  font-size: 19rpx;
  font-weight: 800;
}

.status {
  padding: 4rpx 20rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.status.accepted {
  background: #2D9CFF;
  color: #FFFFFF;
}

.status.cooking {
  background: #FF6B35;
}

.status.ready {
  background: #2FBF71;
}

.order-summary {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.order-meta {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 23rpx;
}

.urge-badge {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 20rpx;
  background: #FF5C8A;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  transform: rotate(-2deg);
}

.order-items {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #FFFDF6;
  border: 3rpx dashed rgba(17, 17, 17, 0.25);
  border-radius: 16rpx;
}

.order-item {
  padding: 6rpx 0;
  border-bottom: 2rpx dashed rgba(17, 17, 17, 0.1);
}

.order-item:last-child {
  border-bottom: none;
}

.oi-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.oi-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.oi-recipe {
  padding: 2rpx 14rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.oi-name {
  font-size: 26rpx;
  font-weight: 800;
}

.oi-qty {
  color: #5C5C5C;
  font-size: 24rpx;
  font-weight: 700;
}

.oi-spec,
.oi-note {
  margin-top: 2rpx;
  color: #5C5C5C;
  font-size: 22rpx;
}

.order-taste,
.order-address {
  margin-top: 10rpx;
  padding: 8rpx 14rpx;
  background: #FFFDF6;
  border: 3rpx dashed rgba(17, 17, 17, 0.3);
  border-radius: 14rpx;
  color: #5C5C5C;
  font-size: 22rpx;
}

.order-allergy {
  margin-top: 10rpx;
  padding: 8rpx 14rpx;
  background: #FFF1F6;
  border: 3rpx solid #FF5C8A;
  border-radius: 14rpx;
  color: #8A2D4A;
  font-size: 22rpx;
  font-weight: 800;
}

.order-note {
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 14rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.order-last-message {
  margin-top: 10rpx;
  padding: 8rpx 14rpx;
  background: #F4EFE3;
  border: 2rpx dashed #111111;
  border-radius: 14rpx;
  color: #4A4A4A;
  font-size: 21rpx;
  word-break: break-all;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
}

.kbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 32rpx;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.kbtn.primary {
  background: #FF6B35;
  box-shadow: 4rpx 4rpx 0 #111111;
}

.kbtn.primary:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: none;
}

.kbtn.ghost {
  background: #FFFFFF;
}

.kbtn.busy,
.dish-toggle.busy {
  opacity: 0.45;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 4rpx 18rpx;
}

.history-toggle {
  padding: 8rpx 22rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 22rpx;
  font-weight: 800;
}

.history-head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.history-all {
  color: #2D9CFF;
  font-size: 21rpx;
  font-weight: 800;
  text-decoration: underline;
}

.history-toggle:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.history-filter {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.history-date-header {
  margin: 18rpx 4rpx 10rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  font-weight: 800;
}

.history-search {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 68rpx;
  padding: 0 18rpx;
  margin-bottom: 12rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
}

.history-search-icon {
  font-size: 22rpx;
}

.history-search-input {
  flex: 1;
  height: 68rpx;
  font-size: 24rpx;
}

.history-search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  background: #EFE9DC;
  border-radius: 999rpx;
  color: #5C5C5C;
  font-size: 26rpx;
  line-height: 1;
}

.history-csv {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  margin: -4rpx 0 14rpx;
  background: #FFFFFF;
  border: 3rpx dashed #111111;
  border-radius: 999rpx;
  color: #5C5C5C;
  font-size: 20rpx;
  font-weight: 800;
}

.history-file-hint {
  margin: -6rpx 0 14rpx;
  color: #8C8C8C;
  font-size: 19rpx;
  text-align: center;
}

.history-filter.range {
  margin-top: -4rpx;
  flex-wrap: wrap;
}

.history-chip {
  padding: 6rpx 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.history-chip.active {
  background: #111111;
  color: #FFFFFF;
}

.history-reply-badge {
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  background: #FF5C8A;
  color: #FFFFFF;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.history-order .order-summary {
  font-size: 26rpx;
}

.history-order .order-meta {
  margin-top: 6rpx;
}

.rating-badge {
  padding: 4rpx 14rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.message-badge {
  padding: 4rpx 14rpx;
  background: #2D9CFF;
  color: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.order-feedback {
