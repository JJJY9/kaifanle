<view class="page">
  <view class="head">
    <text class="title display">爱心券</text>
    <text class="sub">洗碗、奶茶、夸夸卡</text>
  </view>

  <view wx:if="{{isAdmin}}" class="card create-card">
    <view class="create-title">发一张券</view>
    <input
      class="create-input"
      placeholder="券名，比如：洗碗券"
      value="{{newTitle}}"
      maxlength="20"
      bindinput="onTitle"
    />
    <view class="preset-row">
      <view
        wx:for="{{presetTitles}}"
        wx:key="*this"
        class="preset-chip"
        data-title="{{item}}"
        bindtap="onPresetTitle"
      >{{item}}</view>
    </view>
    <input
      class="create-input"
      placeholder="备注，比如：攒够 3 次换一次"
      value="{{newNote}}"
      maxlength="40"
      bindinput="onNote"
    />
    <view class="preset-row">
      <view
        wx:for="{{expiryOptions}}"
        wx:key="days"
        class="preset-chip {{expiryDays === item.days ? 'active' : ''}}"
        data-days="{{item.days}}"
        bindtap="onExpiry"
      >{{item.label}}</view>
    </view>
    <view
      class="create-btn {{creating ? 'disabled' : ''}}"
      bindtap="onCreate"
    >{{creating ? '发放中…' : '发券'}}</view>
  </view>

  <view wx:if="{{loading}}" class="skeleton sk"></view>

  <empty-state
    wx:elif="{{loadFailed}}"
    title="爱心券加载失败"
    desc="没有拿到券列表，先别领取，免得错过上新"
    actionText="重试"
    bind:action="onRetryLoad"
  />

  <block wx:elif="{{coupons.length}}">
    <view wx:for="{{coupons}}" wx:key="id" class="coupon card">
      <view class="coupon-top">
        <view class="coupon-title">{{item.title}}</view>
        <view class="coupon-status {{item.status}} {{item.canClaim ? 'pool' : ''}}">{{item.statusText}}</view>
      </view>
      <view wx:if="{{item.note}}" class="coupon-note">{{item.note}}</view>
      <view class="coupon-foot">
        <view class="coupon-dates">
          <text class="coupon-date">{{item.dateText}}</text>
          <text wx:if="{{item.expiryText}}" class="coupon-date">{{item.expiryText}}</text>
        </view>
        <view class="coupon-actions">
          <view
            wx:if="{{item.canClaim}}"
            class="cbtn primary {{claimingId === item.id ? 'busy' : ''}}"
            data-id="{{item.id}}"
            bindtap="onClaim"
          >{{claimingId === item.id ? '领取中…' : '收下'}}</view>
          <view
            wx:if="{{item.canUse}}"
            class="cbtn {{usingId === item.id ? 'busy' : ''}}"
            data-id="{{item.id}}"
            bindtap="onUse"
          >{{usingId === item.id ? '处理中…' : '用掉'}}</view>
          <view
            wx:if="{{isAdmin}}"
            class="cbtn danger"
            data-id="{{item.id}}"
            bindtap="onDelete"
          >删除</view>
        </view>
      </view>
    </view>
  </block>

  <empty-state
    wx:else
    title="还没有爱心券"
    desc="{{isAdmin ? '发一张券，给她一个小惊喜' : '等掌勺的发券'}}"
  />
</view>
