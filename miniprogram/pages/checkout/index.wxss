.page {
  padding: 24rpx 24rpx 0;
}

.closed-banner {
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  background: #FFD23F;
  border: 3rpx dashed #111111;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.kitchen-hint {
  margin-bottom: 24rpx;
  padding: 14rpx 20rpx;
  background: #E9F8EF;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.block {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.block-title {
  margin-bottom: 16rpx;
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 32rpx;
  font-weight: 800;
}

.block-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.block-title-row .block-title {
  margin-bottom: 0;
}

.clear-cart {
  color: #D9431C;
  font-size: 23rpx;
  font-weight: 800;
}

.qty-stepper {
  display: flex;
  align-items: center;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  overflow: hidden;
}

.qty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 40rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.qty-num {
  min-width: 36rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 800;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.chip-row.last {
  margin-bottom: 0;
}

.addr-input {
  height: 80rpx;
  padding: 0 20rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.chip {
  padding: 12rpx 30rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.chip.active {
  background: #FFD23F;
  box-shadow: 4rpx 4rpx 0 #111111;
  transform: rotate(-2deg);
}

.date-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 30rpx;
  margin-bottom: 26rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 26rpx;
  font-weight: 800;
}

.line {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 3rpx dashed rgba(17, 17, 17, 0.15);
}

.line:last-child {
  border-bottom: none;
}

.line-media {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border: 3rpx solid #111111;
  border-radius: 20rpx;
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 44rpx;
  font-weight: 800;
}

.line-info {
  flex: 1;
  min-width: 0;
}

.line-name {
  font-size: 28rpx;
  font-weight: 800;
  word-break: break-all;
}

.line-qty {
  color: #5C5C5C;
  font-size: 22rpx;
}

.line-spec,
.line-note {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 22rpx;
  word-break: break-all;
}

.line-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.line-price {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 30rpx;
  font-weight: 800;
}

.line-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #111111;
  border-radius: 50%;
  font-size: 26rpx;
  line-height: 1;
}

.line.invalid {
  opacity: 0.7;
}

.line-invalid {
  margin-top: 4rpx;
  color: #FF6B35;
  font-size: 20rpx;
  font-weight: 800;
}

.line-dislike {
  margin-top: 4rpx;
  color: #B85C00;
  font-size: 20rpx;
  font-weight: 800;
}

.slot-empty {
  padding: 28rpx 0;
  color: #5C5C5C;
  font-size: 24rpx;
  text-align: center;
}

.slot-error {
  margin-bottom: 12rpx;
  padding: 12rpx 18rpx;
  background: #FFF7DA;
  border: 3rpx dashed #111111;
  border-radius: 16rpx;
  color: #7A5A00;
  font-size: 22rpx;
  font-weight: 700;
}

.note-input {
  width: 100%;
  height: 140rpx;
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.note-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.note-preset {
  padding: 8rpx 22rpx;
  background: #FFFDF6;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.note-preset:active {
  background: #FFD23F;
}

.note-preset.add {
  background: #FFD23F;
  border-style: dashed;
}

.foot-space {
  height: 220rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFDF6;
  border-top: 4rpx solid #111111;
}

.submit-total {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.submit-label {
  color: #5C5C5C;
  font-size: 20rpx;
  font-weight: 700;
}

.submit-price {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 44rpx;
  font-weight: 800;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 56rpx;
  background: #FF6B35;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 6rpx 6rpx 0 #111111;
  font-size: 30rpx;
  font-weight: 800;
}

.submit-btn:active {
  transform: translate(6rpx, 6rpx);
  box-shadow: none;
}

.submit-btn.disabled {
  opacity: 0.6;
}
