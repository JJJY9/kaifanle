<view class="page">
  <view class="head">
    <view class="title-row">
      <text class="title display">经营月报</text>
      <view class="sticker">近 30 天</view>
    </view>
    <text wx:if="{{report}}" class="sub">{{report.startDate}} 至 {{report.endDate}} · 只统计未取消订单</text>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="skeleton sk-card"></view>
    <view class="skeleton sk-card"></view>
  </view>

  <empty-state
    wx:elif="{{error}}"
    title="月报加载失败"
    desc="{{error}}"
    actionText="再试一次"
    bind:action="onRetry"
  />

  <block wx:elif="{{report}}">
    <view class="stats-card card">
      <view class="stat">
        <text class="stat-num">¥{{report.revenue}}</text>
        <text class="stat-label">30 天营收</text>
      </view>
      <view class="divider"></view>
      <view class="stat">
        <text class="stat-num">{{report.totalOrders}}</text>
        <text class="stat-label">订单</text>
      </view>
      <view class="divider"></view>
      <view class="stat">
        <text class="stat-num">¥{{report.avgOrder}}</text>
        <text class="stat-label">客单价</text>
      </view>
    </view>

    <view wx:if="{{health}}" class="health-card card">
      <view class="health-head">
        <text class="health-title">数据体检</text>
        <text class="health-sub">共 {{health.total}} 道菜</text>
      </view>
      <view class="health-row">
        <view
          class="health-item jump {{health.noRecipe ? 'warn' : ''}}"
          data-filter="missing"
          bindtap="onHealthJump"
        >
          <text class="health-num">{{health.noRecipe}}</text>
          <text class="health-label">缺做法 ›</text>
        </view>
        <view
          class="health-item jump {{health.lowStock ? 'warn' : ''}}"
          data-filter="low"
          bindtap="onHealthJump"
        >
          <text class="health-num">{{health.lowStock}}</text>
          <text class="health-label">低库存 ≤{{health.lowStockThreshold}} ›</text>
        </view>
        <view
          class="health-item jump"
          data-filter="soldout"
          bindtap="onHealthJump"
        >
          <text class="health-num">{{health.soldout}}</text>
          <text class="health-label">售罄 ›</text>
        </view>
        <view
          class="health-item jump"
          data-filter="off"
          bindtap="onHealthJump"
        >
          <text class="health-num">{{health.off}}</text>
          <text class="health-label">已下架 ›</text>
        </view>
      </view>
    </view>

    <view wx:if="{{report.ratedCount}}" class="rating-line card">
      <text>评价 {{report.ratedCount}} 条</text>
      <text>平均 {{report.avgRating}} 分</text>
      <text>好评率 {{report.goodRate}}%</text>
    </view>

    <view wx:if="{{report.topTags && report.topTags.length}}" class="tags-line card">
      <text class="tags-title">她被夸</text>
      <text
        wx:for="{{report.topTags}}"
        wx:key="name"
        class="report-tag"
      >{{item.name}} ×{{item.count}}</text>
    </view>

    <view wx:if="{{compare}}" class="compare card">
      <view class="compare-head">
        <text class="compare-title">本周 vs 上周</text>
        <text class="compare-badge {{compare.trend}}">{{compare.revenueText}}</text>
      </view>
      <view class="compare-row">
        <text class="compare-label">营收</text>
        <text class="compare-value">¥{{compare.thisRevenue}} <text class="compare-prev">/ ¥{{compare.prevRevenue}}</text></text>
      </view>
      <view class="compare-row">
        <text class="compare-label">订单</text>
        <text class="compare-value">{{compare.thisCount}} 单 <text class="compare-prev">/ {{compare.prevCount}} 单 · {{compare.countText}}</text></text>
      </view>
    </view>

    <view wx:if="{{report.mealStats && report.mealStats.length}}" class="meal-stats card">
      <view wx:for="{{report.mealStats}}" wx:key="meal" class="meal-stat">
        <text class="meal-stat-name">{{item.meal === 'breakfast' ? '早餐' : (item.meal === 'lunch' ? '午餐' : '晚餐')}}</text>
        <text class="meal-stat-revenue">¥{{item.revenue}}</text>
        <text class="meal-stat-count">{{item.count}} 单</text>
      </view>
    </view>

    <view
      class="export-btn {{exporting ? 'disabled' : ''}}"
      bindtap="onExport"
    >{{exporting ? '导出中…' : '复制订单 CSV'}}</view>
    <view
      class="export-btn {{exportingFile ? 'disabled' : ''}}"
      bindtap="onExportFile"
    >{{exportingFile ? '生成中…' : '导出 CSV 文件'}}</view>
    <view
      class="export-btn {{backupBusy ? 'disabled' : ''}}"
      bindtap="onBackup"
    >{{backupBusy ? '打包中…' : '备份全部数据 JSON'}}</view>
    <view wx:if="{{exportCount}}" class="export-hint">已复制最近 {{exportCount}} 单，可以直接粘贴到表格</view>
    <view wx:if="{{exportedFile}}" class="export-hint">CSV 文件已生成，可通过微信发送或保存</view>
    <view wx:if="{{backupCount}}" class="export-hint">已备份 {{backupCount}} 项数据，JSON 文件可发送或保存</view>

    <view class="chart card">
      <view class="chart-head">
        <view class="chart-title">每天营收</view>
        <view class="chart-total">单日最高 ¥{{maxAmount}}</view>
      </view>
      <view class="chart-bars">
        <view wx:for="{{bars}}" wx:key="date" class="chart-col">
          <view class="chart-bar-wrap">
            <view
              class="chart-bar {{item.amount ? '' : 'empty'}}"
              style="height: {{item.height}}%;"
            ></view>
          </view>
          <text class="chart-label">{{item.showLabel ? item.label : ''}}</text>
        </view>
      </view>
    </view>

    <view class="section-title display">菜品排行</view>
    <view wx:if="{{!report.topDishes.length}}" class="empty-line">这 30 天还没有卖出的菜</view>
    <view wx:for="{{report.topDishes}}" wx:key="name" class="dish-row card">
      <view class="rank {{index < 3 ? 'top' : ''}}">{{index + 1}}</view>
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-sub">卖出 {{item.qty}} 份 · ¥{{item.revenue}}</view>
      </view>
      <view class="dish-bar-wrap">
        <view
          class="dish-bar"
          style="width: {{report.topDishes[0].qty ? (item.qty / report.topDishes[0].qty * 100) : 0}}%;"
        ></view>
      </view>
    </view>

    <view class="section-title display">好评菜品</view>
    <view wx:if="{{!report.topRatedDishes.length}}" class="empty-line">还没有满 {{report.minRatedOrders}} 次评价的菜</view>
    <view wx:for="{{report.topRatedDishes}}" wx:key="name" class="dish-row card">
      <view class="rank {{index < 3 ? 'top' : ''}}">{{index + 1}}</view>
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-sub">平均 {{item.avgRating}}/3 分 · {{item.ratedCount}} 次评价</view>
      </view>
    </view>

    <view class="foot-note">
      完成 {{report.completed}} 单 · 取消 {{report.cancelled}} 单
    </view>
  </block>
</view>
