<view class="page">
  <view class="profile card">
    <view class="avatar">{{user.char}}</view>
    <view class="info">
      <view class="name">{{user.name}}</view>
      <view class="motto">{{user.motto}}</view>
    </view>
    <view wx:if="{{isAdmin}}" class="sticker">掌勺人</view>
  </view>

  <view class="stats card">
    <view class="stat">
      <view class="stat-num">{{stats.month}}</view>
      <view class="stat-label">本月干饭</view>
    </view>
    <view class="divider"></view>
    <view class="stat">
      <view class="stat-fav">{{stats.favorite}}</view>
      <view class="stat-label">最常点</view>
    </view>
  </view>

  <view class="entries card">
    <view
      wx:for="{{entries}}"
      wx:key="key"
      class="entry"
      data-key="{{item.key}}"
      bindtap="onEntryTap"
    >
      <view class="entry-icon" style="background: {{item.color}};">{{item.icon}}</view>
      <view class="entry-info">
        <view class="entry-label">{{item.label}}</view>
        <view class="entry-desc">{{item.desc}}</view>
      </view>
      <text class="entry-arrow">→</text>
    </view>
  </view>

  <view class="footer">{{cloudMode ? (initialized ? '云开发已连接' : '云开发未初始化') : '本地 mock 模式'}} · 开饭咯 v0.1.0</view>
</view>
