.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
}

.head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx 24rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sub {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.bulk-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.bulk-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  background: #2FBF71;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 26rpx;
  font-weight: 800;
}

.bulk-btn.rest {
  background: #FFFFFF;
}

.bulk-btn:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: none;
}

.meal-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.meal-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meal-name {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 34rpx;
  font-weight: 800;
}

.meal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.meal-label {
  color: #5C5C5C;
  font-size: 24rpx;
}

.time-pill {
  padding: 8rpx 24rpx;
  background: #FFFDF6;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.meal-status {
  display: inline-block;
  margin-top: 16rpx;
  padding: 4rpx 18rpx;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.meal-status.open {
  background: #2FBF71;
}

.meal-status.closed {
  background: #E8E8E8;
  color: #5C5C5C;
}

.block {
  padding: 26rpx;
  margin-bottom: 24rpx;
}

.block-title {
  margin-bottom: 16rpx;
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 32rpx;
  font-weight: 800;
}

.note {
  height: 80rpx;
  padding: 0 20rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.note-hint {
  margin-top: 6rpx;
  color: #5C5C5C;
  font-size: 20rpx;
}

.date-line {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.date-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.date-chip {
  padding: 10rpx 24rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.date-chip.closed {
  background: #FF5C8A;
  box-shadow: 3rpx 3rpx 0 #111111;
  transform: rotate(-1deg);
}

.date-hint {
  margin-top: 12rpx;
  color: #8A8A8A;
  font-size: 20rpx;
}

.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: #FF6B35;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 7rpx 7rpx 0 #111111;
  font-size: 32rpx;
  font-weight: 800;
}

.save-btn:active {
  transform: translate(7rpx, 7rpx);
  box-shadow: none;
}

.save-btn.disabled {
  opacity: 0.6;
}

.sk {
  height: 500rpx;
}
