.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
}

.head {
  padding: 8rpx 4rpx 20rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sub {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.cart-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.summary-total {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 36rpx;
  font-weight: 800;
}

.group {
  margin-bottom: 24rpx;
  padding: 20rpx 22rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 3rpx dashed #E0E0E0;
}

.group-title {
  font-size: 28rpx;
  font-weight: 800;
}

.group-clear {
  color: #D9431C;
  font-size: 21rpx;
  font-weight: 700;
}

.line {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx dashed #EEE6D8;
}

.line-char {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: 3rpx solid #111111;
  border-radius: 20rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.line-info {
  flex: 1;
  min-width: 0;
}

.line-name {
  font-size: 26rpx;
  font-weight: 800;
  word-break: break-all;
}

.line-spec,
.line-note {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 21rpx;
  word-break: break-all;
}

.line-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
}

.line-price {
  font-size: 24rpx;
  font-weight: 800;
}

.qty {
  display: flex;
  align-items: center;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  overflow: hidden;
}

.qbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 38rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.qnum {
  min-width: 40rpx;
  text-align: center;
  font-size: 23rpx;
  font-weight: 800;
}

.line-remove {
  color: #9A9A9A;
  font-size: 21rpx;
  font-weight: 700;
}

.line-total {
  align-self: flex-end;
  font-size: 26rpx;
  font-weight: 800;
}

.group-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
}

.group-sum {
  color: #5C5C5C;
  font-size: 22rpx;
  font-weight: 700;
}

.group-go {
  padding: 10rpx 24rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 24rpx;
  font-weight: 800;
}

.group-go:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}
