<view class="page">
  <view wx:if="{{loading}}" class="skeleton sk"></view>

  <block wx:else>
    <view class="card block">
      <view class="block-title">基本信息</view>

      <view class="field">
        <text class="label">名称</text>
        <input
          class="input"
          placeholder="比如：番茄牛腩饭"
          value="{{name}}"
          maxlength="20"
          bindinput="onName"
        />
      </view>

      <view class="field">
        <text class="label">描述</text>
        <input
          class="input"
          placeholder="一句话介绍，最多 40 字"
          value="{{desc}}"
          maxlength="40"
          bindinput="onDesc"
        />
      </view>

      <view class="field">
        <text class="label">价格</text>
        <input
          class="input"
          type="digit"
          placeholder="0"
          value="{{price}}"
          bindinput="onPrice"
        />
      </view>

      <view class="field">
        <text class="label">库存</text>
        <input
          class="input"
          type="number"
          placeholder="-1 表示不限量"
          value="{{stock}}"
          bindinput="onStock"
        />
      </view>

      <view class="field field-column">
        <text class="label">分类</text>
        <view class="chips">
          <view
            wx:for="{{categories}}"
            wx:key="id"
            class="chip {{categoryId === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSelectCategory"
          >{{item.name}}</view>
        </view>
      </view>

      <view class="field field-column">
        <text class="label">餐次</text>
        <view class="chips">
          <view
            wx:for="{{meals}}"
            wx:key="id"
            class="chip {{mealChecked[item.id] ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onToggleMeal"
          >{{item.name}}</view>
        </view>
      </view>

      <view class="field">
        <text class="label">标签</text>
        <input
          class="input"
          placeholder="逗号分隔，如：招牌，微辣"
          value="{{tagsText}}"
          bindinput="onTags"
        />
      </view>

      <view class="field">
        <text class="label">辣度</text>
        <input
          class="input"
          placeholder="逗号分隔，如：不辣，微辣"
          value="{{spicyText}}"
          bindinput="onSpicy"
        />
      </view>
    </view>

    <view class="card block">
      <view class="block-title">做法</view>
      <textarea
        class="recipe-input"
        placeholder="每行一步，比如：牛腩切块焯水 / 番茄炒出汁再下牛腩 / 小火炖 60 分钟"
        value="{{recipe}}"
        maxlength="1200"
        bindinput="onRecipe"
      ></textarea>
      <view class="recipe-tip">点单时可以在「怎么做」里展开查看，留空则不显示</view>
    </view>

    <view class="card block">
      <view class="block-title">加料</view>
      <view wx:for="{{addons}}" wx:key="key" class="addon-row">
        <input
          class="addon-name"
          placeholder="加料名"
          value="{{item.name}}"
          data-index="{{index}}"
          bindinput="onAddonName"
        />
        <input
          class="addon-price"
          type="digit"
          placeholder="价格"
          value="{{item.price}}"
          data-index="{{index}}"
          bindinput="onAddonPrice"
        />
        <view class="remove" data-index="{{index}}" bindtap="onRemoveAddon">×</view>
      </view>
      <view class="add-row" bindtap="onAddAddon">+ 添加加料</view>
    </view>

    <view class="card block">
      <view class="block-title">展示</view>

      <view class="field field-column">
        <text class="label">菜品图片</text>
        <view class="image-row">
          <view wx:if="{{image}}" class="image-preview">
            <image class="image-thumb" src="{{image}}" mode="aspectFill" />
            <view class="image-remove" bindtap="onRemoveImage">×</view>
          </view>
          <view wx:else class="image-add" bindtap="onChooseImage">
            <text class="image-plus">{{uploading ? '…' : '+'}}</text>
            <text class="image-hint">{{uploading ? '上传中' : '拍照 / 相册'}}</text>
          </view>
          <view wx:if="{{image}}" class="image-replace" bindtap="onChooseImage">
            {{uploading ? '上传中…' : '换一张'}}
          </view>
        </view>
        <text class="image-tip">不传图片时显示卡通插画；上传自己的照片后会优先用照片</text>
      </view>

      <view class="field field-column">
        <text class="label">色块</text>
        <view class="colors">
          <view
            wx:for="{{colors}}"
            wx:key="*this"
            class="color-dot {{colorIndex === index ? 'active' : ''}}"
            style="background: {{item}};"
            data-index="{{index}}"
            bindtap="onSelectColor"
          ></view>
        </view>
      </view>

      <view class="field">
        <text class="label">推荐</text>
        <switch
          checked="{{isRecommended}}"
          color="#FF6B35"
          bindchange="onRecommended"
        />
      </view>

      <view class="field field-column">
        <text class="label">状态</text>
        <view class="chips">
          <view
            wx:for="{{statuses}}"
            wx:key="id"
            class="chip {{status === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSelectStatus"
          >{{item.name}}</view>
        </view>
      </view>
    </view>

    <view
      class="save-btn {{saving ? 'disabled' : ''}}"
      bindtap="onSave"
    >{{saving ? '保存中…' : (isEdit ? '保存修改' : '创建菜品')}}</view>

    <view
      wx:if="{{isEdit}}"
      class="delete-btn {{deleting ? 'disabled' : ''}}"
      bindtap="onDelete"
    >{{deleting ? '删除中…' : '删除这道菜'}}</view>
  </block>
</view>
