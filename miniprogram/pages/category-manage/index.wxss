.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
}

.head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx 24rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sub {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.form {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.form-title {
  margin-bottom: 16rpx;
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 32rpx;
  font-weight: 800;
}

.input {
  height: 76rpx;
  padding: 0 20rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  font-size: 26rpx;
}

.colors {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid #111111;
  border-radius: 50%;
}

.color-dot.active {
  box-shadow: 4rpx 4rpx 0 #111111;
  transform: scale(1.06);
}

.form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: #FF6B35;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 5rpx 5rpx 0 #111111;
  font-size: 26rpx;
  font-weight: 800;
}

.btn:active {
  transform: translate(5rpx, 5rpx);
  box-shadow: none;
}

.btn.ghost {
  background: #FFFFFF;
  box-shadow: none;
}

.btn.disabled {
  opacity: 0.6;
}

.cat {
  padding: 6rpx 24rpx;
}

.cat-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 3rpx dashed rgba(17, 17, 17, 0.12);
}

.cat-row:last-child {
  border-bottom: none;
}

.cat-dot {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #111111;
  border-radius: 12rpx;
}

.cat-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 800;
}

.cat-move {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cat-move-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 36rpx;
  background: #EFE9DC;
  border: 2rpx solid #111111;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.cat-move-btn.disabled {
  opacity: 0.4;
}

.cat-btn {
  padding: 8rpx 22rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.cat-btn.danger {
  color: #D9431C;
  border-color: #D9431C;
}

.cat-btn.disabled {
  opacity: 0.5;
}

.sk {
  height: 400rpx;
}
