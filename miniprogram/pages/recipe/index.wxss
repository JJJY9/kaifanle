.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
}

.hero {
  display: flex;
  gap: 22rpx;
  padding: 20rpx;
}

.hero-media {
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #111111;
  border-radius: 26rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-char {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 100rpx;
  font-weight: 800;
  transform: rotate(-8deg);
}

.hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.dish-name {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name-row .dish-name {
  flex: 1;
  min-width: 0;
}

.fav {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  background: #FFFDF6;
  border: 3rpx solid #111111;
  border-radius: 50%;
  font-size: 30rpx;
  line-height: 1;
}

.fav.on {
  background: #FF5C8A;
}

.dish-desc {
  color: #5C5C5C;
  font-size: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 4rpx;
}

.tag {
  padding: 2rpx 14rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 800;
  transform: rotate(-2deg);
}

.steps-card {
  margin-top: 24rpx;
  padding: 24rpx;
}

.steps-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.steps-title {
  font-size: 34rpx;
  font-weight: 800;
}

.steps-reset {
  color: #2D9CFF;
  font-size: 21rpx;
  font-weight: 800;
}

.ingredient-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ingredient-row {
  display: flex;
  gap: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.ingredient-dot {
  color: #FF6B35;
  font-weight: 800;
}

.ingredient-text {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.allergen-line {
  margin-top: 14rpx;
  padding: 8rpx 14rpx;
  background: #FFF4C2;
  border: 2rpx solid #111111;
  border-radius: 12rpx;
  color: #D9431C;
  font-size: 22rpx;
  font-weight: 800;
}

.step-row {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 3rpx dashed rgba(17, 17, 17, 0.12);
}

.step-row:last-child {
  border-bottom: none;
}

.step-no {
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF6B35;
  border: 3rpx solid #111111;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 800;
}

.step-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.6;
}

.step-row.done .step-text {
  color: #9A9A9A;
  text-decoration: line-through;
}

.step-row.done .step-no {
  background: #2FBF71;
  color: #FFFFFF;
}

.empty-steps {
  padding: 28rpx;
  background: #FFFDF6;
  border: 3rpx dashed #111111;
  border-radius: 20rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  text-align: center;
}

.actions {
  margin-top: 28rpx;
}

.poster-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  margin-top: 24rpx;
  background: #FFFFFF;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 5rpx 5rpx 0 #111111;
  font-size: 26rpx;
  font-weight: 800;
}

.poster-btn:active {
  transform: translate(5rpx, 5rpx);
  box-shadow: none;
}

.poster-btn.disabled {
  opacity: 0.6;
}

.poster-hint {
  margin-top: 10rpx;
  color: #5C5C5C;
  font-size: 20rpx;
  text-align: center;
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 900px;
  pointer-events: none;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 8rpx 8rpx 0 #111111;
}

.btn:active {
  transform: translate(8rpx, 8rpx);
  box-shadow: none;
}

.btn-primary {
  background: #FF6B35;
}

.sk {
  height: 600rpx;
}
