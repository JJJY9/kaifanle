<view wx:if="{{loading}}" class="page">
  <view class="skeleton sk"></view>
</view>

<view wx:elif="{{error}}" class="page">
  <empty-state
    title="菜谱加载失败"
    desc="{{error}}"
    actionText="再试一次"
    bind:action="onRetry"
  />
</view>

<view wx:elif="{{dish}}" class="page">
  <view class="hero card">
    <view class="hero-media" style="background: {{dish.color}};">
      <image wx:if="{{(dish.image || dish.cartoon) && !imageFailed}}" class="hero-img" src="{{dish.image || dish.cartoon}}" mode="aspectFill" binderror="onImageError" />
      <text wx:else class="hero-char">{{dish.emoji || dish.char}}</text>
    </view>
    <view class="hero-info">
      <view class="name-row">
        <view class="dish-name display">{{dish.name}}</view>
        <view
          class="fav {{favorite ? 'on' : ''}}"
          bindtap="onToggleFavorite"
        >{{favorite ? '♥' : '♡'}}</view>
      </view>
      <view class="dish-desc">{{dish.desc}}</view>
      <view class="tags">
        <text wx:for="{{dish.tags}}" wx:key="*this" class="tag">{{item}}</text>
      </view>
      <view wx:if="{{statsText}}" class="dish-stats">{{statsText}}</view>
    </view>
  </view>

  <view wx:if="{{dish.ingredients && dish.ingredients.length}}" class="steps-card card">
    <view class="steps-title display">食材</view>
    <view class="ingredient-list">
      <view wx:for="{{dish.ingredients}}" wx:key="*this" class="ingredient-row">
        <text class="ingredient-dot">·</text>
        <text class="ingredient-text">{{item}}</text>
      </view>
    </view>
    <view wx:if="{{dish.allergens && dish.allergens.length}}" class="allergen-line">
      含：{{dish.allergens}}
    </view>
  </view>

  <view class="steps-card card">
    <view class="steps-title-row">
      <view class="steps-title display">怎么做</view>
      <view wx:if="{{doneCount}}" class="steps-reset" bindtap="onResetSteps">重置 {{doneCount}}/{{stepViews.length}}</view>
    </view>
    <block wx:if="{{stepViews.length}}">
      <view
        wx:for="{{stepViews}}"
        wx:key="index"
        class="step-row {{item.done ? 'done' : ''}}"
        data-index="{{index}}"
        bindtap="onToggleStep"
      >
        <view class="step-no">{{item.done ? '✓' : index + 1}}</view>
        <view class="step-text">{{item.text}}</view>
      </view>
    </block>
    <view wx:else class="empty-steps">这道菜还没写做法，可以在菜品编辑里补充</view>
  </view>

  <view class="poster-btn {{posterMaking ? 'disabled' : ''}}" bindtap="onSharePoster">
    {{posterMaking ? '生成中…' : '生成菜品海报'}}
  </view>
  <view wx:if="{{posterPath}}" class="poster-hint" bindtap="onPreviewPoster">海报已生成，点这里分享 ›</view>
  <view wx:if="{{posterPath}}" class="poster-btn" bindtap="onSavePoster">保存海报到相册</view>

  <view wx:if="{{isAdmin}}" class="actions">
    <view class="btn btn-primary" bindtap="onEdit">编辑菜品与做法</view>
  </view>

  <canvas type="2d" id="poster" class="poster-canvas"></canvas>
</view>
