.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFDF6;
  border-top: 4rpx solid #111111;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-text {
  padding: 6rpx 24rpx;
  border: 3rpx solid transparent;
  border-radius: 999rpx;
  color: #5C5C5C;
  font-size: 28rpx;
  font-weight: 800;
  transition: transform 0.12s ease;
}

.tab-text.active {
  background: #FF6B35;
  border-color: #111111;
  color: #111111;
  box-shadow: 4rpx 4rpx 0 #111111;
  transform: rotate(-2deg);
}
