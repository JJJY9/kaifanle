.page {
  min-height: 100vh;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 320rpx;
}

.header {
  padding-top: 8rpx;
}

.top-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 200rpx;
}

.date {
  color: #5C5C5C;
  font-size: 24rpx;
  font-weight: 700;
}

.status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 22rpx;
  font-weight: 800;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #2FBF71;
  border: 2rpx solid #111111;
  border-radius: 50%;
}

.status.closed .status-dot {
  background: #B8B8B8;
}

.title-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.big-title {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 68rpx;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: 2rpx;
}

.sticker-title {
  padding: 2rpx 16rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 8rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 22rpx;
  font-weight: 800;
  transform: rotate(-4deg);
}

.sub-line {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  font-weight: 600;
}

.week-summary {
  display: flex;
  align-items: center;
  gap: 10rpx;
  align-self: flex-start;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  background: #FFF7DA;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  color: #5C5C5C;
  font-size: 20rpx;
  font-weight: 700;
}

.week-copy {
  padding: 1rpx 10rpx;
  background: #FFFFFF;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.week-summary:active {
  transform: translateY(2rpx);
  opacity: 0.85;
}

.sub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 200rpx;
}

.surprise {
  margin-top: 2rpx;
  padding: 6rpx 20rpx;
  background: #FFD23F;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 22rpx;
  font-weight: 800;
  transform: rotate(-2deg);
}

.surprise:active {
  transform: translate(3rpx, 3rpx) rotate(-2deg);
  box-shadow: none;
}

.meal-tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.date-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.date-pill {
  padding: 8rpx 20rpx;
  background: #FFF7DA;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 22rpx;
  font-weight: 800;
}

.date-quick {
  padding: 6rpx 16rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.date-quick.active {
  background: #FFD23F;
  box-shadow: 2rpx 2rpx 0 #111111;
}

.date-hint {
  color: #5C5C5C;
  font-size: 20rpx;
  font-weight: 700;
}

.deadline-hint {
  margin: 10rpx 4rpx 0;
  color: #FF6B35;
  font-size: 21rpx;
  font-weight: 800;
}

.active-order {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 12rpx 18rpx;
  background: #E9F8EF;
  border: 3rpx solid #111111;
  border-radius: 20rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
}

.active-order-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.active-order-label-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.active-order-label {
  color: #2F7D4F;
  font-size: 19rpx;
  font-weight: 800;
}

.active-order-badge {
  padding: 0 10rpx;
  background: #FF5C8A;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 1.5;
}

.active-order-eta {
  margin-top: 2rpx;
  color: #FF6B35;
  font-size: 20rpx;
  font-weight: 800;
}

.active-order-text {
  font-size: 23rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.active-order-message {
  margin-top: 2rpx;
  color: #2F7D4F;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.active-order-arrow {
  flex-shrink: 0;
  color: #2F7D4F;
  font-size: 21rpx;
  font-weight: 800;
}

.coupon-reminder {
  margin-top: 10rpx;
  padding: 10rpx 18rpx;
  background: #FFB3C7;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 22rpx;
  font-weight: 800;
}

.review-reminder {
  margin-top: 10rpx;
  padding: 10rpx 18rpx;
  background: #FFF4C2;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  font-size: 22rpx;
  font-weight: 800;
}

.special-reminder {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
  padding: 10rpx 18rpx;
  background: #FFF1F6;
  border: 3rpx solid #111111;
  border-radius: 18rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
  color: #8A2D4A;
  font-size: 22rpx;
  font-weight: 800;
}

.special-reminder:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.special-arrow {
  flex: 0 0 auto;
  color: #5C5C5C;
  font-size: 20rpx;
}

.busy-line {
  margin: 6rpx 4rpx 0;
  color: #5C5C5C;
  font-size: 20rpx;
  font-weight: 700;
}

.meal-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  background: #FFFFFF;
  border: 4rpx solid #111111;
  border-radius: 24rpx;
  box-shadow: 5rpx 5rpx 0 #111111;
  font-size: 28rpx;
  font-weight: 800;
  transition: transform 0.08s ease, box-shadow 0.08s ease;
}

.meal-tab:active {
  transform: translate(5rpx, 5rpx);
  box-shadow: none;
}

.meal-tab.active {
  background: #111111;
  color: #FFFFFF;
}

.meal-notice {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  background: #FFD23F;
  border: 3rpx dashed #111111;
  border-radius: 16rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.notice-box {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 20rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
}

.notice-tag {
  flex: 0 0 auto;
  padding: 2rpx 14rpx;
  background: #FF5C8A;
  border: 3rpx solid #111111;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 800;
  transform: rotate(-3deg);
}

.notice-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.week-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #FFF7DA;
  border: 3rpx solid #111111;
  border-radius: 20rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
}

.week-entry:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: none;
}

.week-entry-text {
  font-size: 24rpx;
  font-weight: 800;
}

.week-entry-arrow {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
  margin-top: 20rpx;
  padding: 0 22rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
}

.search-icon {
  font-size: 26rpx;
  line-height: 1;
}

.search-history {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.search-suggest {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background: #FFF7DA;
  border: 3rpx solid #111111;
  border-radius: 24rpx;
}

.search-suggest-title {
  color: #5C5C5C;
  font-size: 21rpx;
  font-weight: 800;
}

.search-suggest-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.search-suggest-chip {
  padding: 6rpx 18rpx;
  background: #FFFFFF;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.search-history-label {
  color: #5C5C5C;
  font-size: 20rpx;
  font-weight: 700;
}

.search-history-chip {
  padding: 4rpx 14rpx;
  background: #FFFFFF;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.search-history-clear {
  color: #9A9A9A;
  font-size: 19rpx;
  font-weight: 700;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 26rpx;
  font-weight: 700;
}

.search-placeholder {
  color: #A9A9A9;
  font-weight: 500;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: #EFE9DC;
  border: 2rpx solid #111111;
  border-radius: 50%;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.search-list {
  margin-top: 32rpx;
}

.fav-row {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.fav-chip {
  padding: 8rpx 22rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.fav-chip.active {
  background: #FF5C8A;
  box-shadow: 3rpx 3rpx 0 #111111;
  transform: rotate(-1deg);
}

.cat-jump {
  width: 100%;
  margin-top: 14rpx;
  white-space: nowrap;
}

.spice-row {
  width: 100%;
  margin-top: 10rpx;
  white-space: nowrap;
}

.spice-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 18rpx;
  margin-right: 10rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.spice-chip.active {
  background: #FFD23F;
  box-shadow: 2rpx 2rpx 0 #111111;
}

.last-order {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 14rpx 20rpx;
  background: #FFF4C2;
  border: 3rpx solid #111111;
  border-radius: 22rpx;
  box-shadow: 3rpx 3rpx 0 #111111;
}

.tag-filter-row {
  width: 100%;
  margin-top: 10rpx;
  white-space: nowrap;
}

.tag-filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 48rpx;
  padding: 0 18rpx;
  margin-right: 10rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.tag-filter-chip.active {
  background: #2D9CFF;
  color: #FFFFFF;
  box-shadow: 2rpx 2rpx 0 #111111;
}

.tag-filter-count {
  font-size: 18rpx;
  opacity: 0.7;
}

.last-order-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.last-order-label {
  color: #5C5C5C;
  font-size: 19rpx;
  font-weight: 700;
}

.last-order-name {
  font-size: 23rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.last-order-go {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  background: #2FBF71;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.cat-jump-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 18rpx;
  margin-right: 10rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.cat-jump-chip:active {
  background: #FFD23F;
}

.cat-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 80;
  background: #FFFDF6;
  border-bottom: 3rpx solid #111111;
  box-shadow: 0 4rpx 0 rgba(17, 17, 17, 0.08);
}

.cat-bar-scroll {
  width: 100%;
  padding: 8rpx 24rpx 12rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.cat-bar-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 18rpx;
  margin-right: 10rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.cat-bar-chip:active {
  background: #FFD23F;
}

.hero {
  margin-top: 32rpx;
  background: #FFFFFF;
  border: 4rpx solid #111111;
  border-radius: 44rpx;
  box-shadow: 10rpx 10rpx 0 #111111;
  overflow: hidden;
}

.hero-media {
  position: relative;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 4rpx solid #111111;
}

.hero-char {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 200rpx;
  font-weight: 800;
  line-height: 1;
  color: rgba(17, 17, 17, 0.85);
  transform: rotate(-8deg);
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-sticker {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 8rpx 22rpx;
  background: #FFFFFF;
  border: 4rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 24rpx;
  font-weight: 800;
  transform: rotate(6deg);
}

.hero-body {
  padding: 20rpx 24rpx 24rpx;
}

.hero-name {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 6rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.hero-switch {
  align-self: flex-start;
  margin-top: 10rpx;
  padding: 3rpx 14rpx;
  background: #FFF7DA;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 800;
}

.hero-switch:active {
  transform: translateY(2rpx);
}

.hero-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.hero-price {
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 22rpx;
  font-weight: 800;
}

.price-num {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: #FF6B35;
  border: 4rpx solid #111111;
  border-radius: 50%;
  box-shadow: 5rpx 5rpx 0 #111111;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-add:active {
  transform: translate(5rpx, 5rpx);
  box-shadow: none;
}

.section {
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.section-dot {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #111111;
  border-radius: 6rpx;
}

.section-title {
  font-family: 'SmileySans', 'PingFang SC', sans-serif;
  font-size: 38rpx;
  font-weight: 800;
}

.section-line {
  flex: 1;
  margin-left: 6rpx;
  border-top: 3rpx dashed #111111;
  opacity: 0.35;
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.loading {
  margin-top: 32rpx;
}

.sk-hero {
  height: 480rpx;
}

.sk-row {
  height: 208rpx;
  margin-top: 20rpx;
}
