<view class="page">
  <view class="head">
    <text class="title display">菜谱大全</text>
    <text class="sub">共 {{total}} 道带做法 · 每道菜都教你做</text>
  </view>

  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜菜名或食材"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onSearch"
      bindconfirm="onSearchConfirm"
    />
    <view wx:if="{{keyword}}" class="search-clear" bindtap="onSearchClear">×</view>
  </view>

  <view wx:if="{{!keyword && recipeSearchHistory.length}}" class="search-history">
    <text class="search-history-label">最近搜</text>
    <view
      wx:for="{{recipeSearchHistory}}"
      wx:key="*this"
      class="search-history-chip"
      data-keyword="{{item}}"
      bindtap="onRecipeHistoryTap"
      bindlongpress="onRecipeHistoryRemove"
    >{{item}}</view>
    <text class="search-history-clear" bindtap="onRecipeHistoryClear">清空</text>
  </view>

  <view class="list-tools">
    <view class="tool-chip {{favOnly ? 'on' : ''}}" bindtap="onToggleFavOnly">♡ 只看收藏</view>
    <view class="tool-chip" bindtap="onRandomRecipe">🎲 随机一道</view>
  </view>

  <view wx:if="{{loading}}" class="skeleton sk"></view>

  <view wx:elif="{{error}}" class="page-inner">
    <empty-state
      title="菜谱加载失败"
      desc="{{error}}"
      actionText="再试一次"
      bind:action="onRetry"
    />
  </view>

  <block wx:elif="{{displayGroups.length}}">
    <view wx:for="{{displayGroups}}" wx:key="id" class="section">
      <view class="section-head">
        <view class="section-dot" style="background: {{item.color}};"></view>
        <text class="section-name">{{item.name}}</text>
        <view class="section-line"></view>
      </view>
      <view class="list card">
        <view
          wx:for="{{item.dishes}}"
          wx:for-item="dish"
          wx:key="id"
          class="row"
          data-id="{{dish.id}}"
          bindtap="onTapDish"
        >
          <view class="dot" style="background: {{dish.color}};">
            <image wx:if="{{dish.image || dish.cartoon}}" class="dot-img" src="{{dish.image || dish.cartoon}}" mode="aspectFill" lazy-load />
            <text wx:else class="dot-char">{{dish.emoji || dish.char}}</text>
          </view>
          <view class="info">
            <view class="name">{{dish.name}}</view>
            <view class="step-preview">{{dish.firstStep}}</view>
          </view>
          <view class="meta">
            <view
              class="row-fav {{dish.favorite ? 'on' : ''}}"
              catchtap="onToggleFavorite"
              data-id="{{dish.id}}"
            >{{dish.favorite ? '♥' : '♡'}}</view>
            <text class="steps">{{dish.stepsCount}} 步</text>
            <text class="arrow">→</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <empty-state
    wx:else
    title="{{emptyTitle}}"
    desc="{{emptyDesc}}"
  />
</view>
