.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
}

.head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx 24rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sub {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.summary {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
}

.summary-actions {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.custom-add {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 22rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.custom-add:active {
  background: #FFD23F;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
  padding: 0 22rpx;
  margin-bottom: 18rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
}

.search-history {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin: -6rpx 0 14rpx;
}

.search-history-label {
  color: #8C8C8C;
  font-size: 19rpx;
}

.search-history-chip {
  padding: 3rpx 14rpx;
  background: #FFF7DA;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.search-history-clear {
  color: #8C8C8C;
  font-size: 19rpx;
}

.search-icon {
  font-size: 26rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 26rpx;
  font-weight: 700;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: #EFE9DC;
  border: 2rpx solid #111111;
  border-radius: 50%;
  font-size: 30rpx;
  font-weight: 800;
}

.chip-scroll {
  width: 100%;
  margin-bottom: 18rpx;
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.filter-chip {
  padding: 8rpx 26rpx;
  background: #FFFFFF;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.filter-chip.active {
  background: #FFD23F;
  box-shadow: 3rpx 3rpx 0 #111111;
  transform: rotate(-1deg);
}

.filter-chip.missing.active {
  background: #FF5C8A;
  color: #FFFFFF;
}

.summary-info {
  flex: 1;
  min-width: 0;
}

.summary-title {
  font-size: 27rpx;
  font-weight: 800;
}

.summary-sub {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 21rpx;
}

.add-all {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 28rpx;
  background: #FF6B35;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 24rpx;
  font-weight: 800;
}

.add-all:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: none;
}

.add-all.disabled {
  opacity: 0.5;
}

.list {
  padding: 6rpx 24rpx;
}

.tpl-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 3rpx dashed rgba(17, 17, 17, 0.12);
}

.tpl-row:last-child {
  border-bottom: none;
}

.tpl-row.done {
  opacity: 0.55;
}

.tpl-dot {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #111111;
  border-radius: 14rpx;
}

.tpl-info {
  flex: 1;
  min-width: 0;
}

.tpl-name {
  font-size: 27rpx;
  font-weight: 800;
}

.tpl-price {
  margin-left: 8rpx;
  color: #D9431C;
  font-size: 22rpx;
}

.tpl-desc {
  margin-top: 2rpx;
  color: #5C5C5C;
  font-size: 21rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tpl-meta {
  margin-top: 2rpx;
  color: #8A8A8A;
  font-size: 20rpx;
}

.tpl-add {
  flex: 0 0 auto;
  padding: 8rpx 22rpx;
  background: #2FBF71;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.tpl-add:active {
  background: #FFD23F;
}

.tpl-add.disabled {
  opacity: 0.5;
}

.tpl-done {
  flex: 0 0 auto;
  padding: 8rpx 18rpx;
  color: #8A8A8A;
  font-size: 21rpx;
}

.import-entry {
  margin-top: 20rpx;
  padding: 20rpx;
  text-align: center;
  color: #2D9CFF;
  font-size: 23rpx;
  font-weight: 800;
}

.sk {
  height: 500rpx;
}
