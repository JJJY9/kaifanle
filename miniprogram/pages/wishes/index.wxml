<view class="page">
  <view class="head">
    <text class="title display">许愿池</text>
    <text class="sub">想吃什么，写下来</text>
  </view>

  <view class="wish-form card">
    <view class="wish-row">
      <input
        class="wish-input"
        placeholder="比如：想吃番茄牛腩饭"
        value="{{content}}"
        maxlength="50"
        bindinput="onContent"
      />
      <view
        class="wish-submit {{submitting ? 'disabled' : ''}}"
        bindtap="onSubmit"
      >{{submitting ? '…' : '许愿'}}</view>
    </view>
    <view class="preset-row">
      <view
        wx:for="{{presets}}"
        wx:key="*this"
        class="preset-chip"
        data-text="{{item}}"
        bindtap="onPreset"
      >{{item}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="skeleton sk"></view>

  <block wx:elif="{{wishes.length}}">
    <view wx:for="{{wishes}}" wx:key="id" class="wish card">
      <view class="wish-top">
        <view class="wish-status {{item.status}}">{{item.statusText}}</view>
        <text class="wish-date">{{item.dateText}}</text>
      </view>
      <view class="wish-content">{{item.content}}</view>
      <view wx:if="{{item.plannedDate}}" class="wish-plan">安排：{{item.plannedDate}}</view>
      <view wx:if="{{item.reply}}" class="wish-reply">回复：{{item.reply}}</view>
      <view wx:if="{{isAdmin}}" class="wish-actions">
        <view
          wx:if="{{item.status === 'pending'}}"
          class="wish-btn"
          data-id="{{item.id}}"
          bindtap="onPlan"
        >安排</view>
        <view
          wx:if="{{item.status !== 'done'}}"
          class="wish-btn primary"
          data-id="{{item.id}}"
          bindtap="onDone"
        >吃上了</view>
        <view
          class="wish-btn"
          data-id="{{item.id}}"
          bindtap="onReply"
        >回一句</view>
        <view
          class="wish-btn"
          data-content="{{item.content}}"
          bindtap="onMakeDish"
        >做成菜</view>
        <view
          class="wish-btn danger"
          data-id="{{item.id}}"
          bindtap="onDeleteWish"
        >删除</view>
      </view>
      <view wx:if="{{!isAdmin && item.status === 'pending'}}" class="wish-actions">
        <view
          class="wish-btn {{deletingId === item.id ? 'disabled' : ''}}"
          data-id="{{item.id}}"
          bindtap="onDeleteWish"
        >{{deletingId === item.id ? '撤回中…' : '撤回'}}</view>
      </view>
    </view>
  </block>

  <empty-state
    wx:else
    title="许愿池还是空的"
    desc="想吃什么，写下来告诉掌勺的"
  />
</view>
