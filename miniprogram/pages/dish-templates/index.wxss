.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
}

.head {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx 24rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.sub {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 24rpx;
}

.summary {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
}

.summary-info {
  flex: 1;
  min-width: 0;
}

.summary-title {
  font-size: 27rpx;
  font-weight: 800;
}

.summary-sub {
  margin-top: 4rpx;
  color: #5C5C5C;
  font-size: 21rpx;
}

.add-all {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 28rpx;
  background: #FF6B35;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 24rpx;
  font-weight: 800;
}

.add-all:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: none;
}

.add-all.disabled {
  opacity: 0.5;
}

.list {
  padding: 6rpx 24rpx;
}

.tpl-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 3rpx dashed rgba(17, 17, 17, 0.12);
}

.tpl-row:last-child {
  border-bottom: none;
}

.tpl-row.done {
  opacity: 0.55;
}

.tpl-dot {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #111111;
  border-radius: 14rpx;
}

.tpl-info {
  flex: 1;
  min-width: 0;
}

.tpl-name {
  font-size: 27rpx;
  font-weight: 800;
}

.tpl-price {
  margin-left: 8rpx;
  color: #D9431C;
  font-size: 22rpx;
}

.tpl-desc {
  margin-top: 2rpx;
  color: #5C5C5C;
  font-size: 21rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tpl-meta {
  margin-top: 2rpx;
  color: #8A8A8A;
  font-size: 20rpx;
}

.tpl-add {
  flex: 0 0 auto;
  padding: 8rpx 22rpx;
  background: #2FBF71;
  border: 3rpx solid #111111;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.tpl-add:active {
  background: #FFD23F;
}

.tpl-add.disabled {
  opacity: 0.5;
}

.tpl-done {
  flex: 0 0 auto;
  padding: 8rpx 18rpx;
  color: #8A8A8A;
  font-size: 21rpx;
}

.sk {
  height: 500rpx;
}
