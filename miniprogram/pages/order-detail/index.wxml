<view wx:if="{{order}}" class="page">  <view class="status-card card">
    <view class="status-top">
      <view class="status-badge {{order.status}}">{{statusText}}</view>
      <text class="status-no">#{{order.no}}</text>
    </view>
    <view class="status-sub">{{order.mealText}} · {{order.mode}} · {{order.expectedTime}}</view>
    <view wx:if="{{order.status === 'cancelled'}}" class="cancel-reason">
      <text>{{order.cancelledBy === 'admin' ? '掌勺人取消' : '你取消'}}</text>
      <text wx:if="{{order.cancelReason}}">：{{order.cancelReason}}</text>
    </view>
    <view wx:if="{{queueText}}" class="queue-tip">{{queueText}}</view>
    <view wx:if="{{order.status === 'ready'}}" class="ready-tip">锅已经端上桌，趁热吃！</view>
    <view
      wx:if="{{order.status === 'pending' || order.status === 'accepted' || order.status === 'cooking'}}"
      class="urge {{order.urgeCooling ? 'cooling' : ''}}"
      bindtap="onUrge"
    >{{order.urgeCooling ? '刚催过，掌勺人收到啦' : '催一下 🔔'}}</view>
    <view
      wx:if="{{order.status === 'pending' || order.status === 'accepted'}}"
      class="notify-ready"
      bindtap="onSubscribeReady"
    >出锅时提醒我</view>
    <view
      wx:if="{{order.status === 'pending'}}"
      class="cancel-order"
      bindtap="onCancelOrder"
    >取消订单</view>
    <view class="copy-order" bindtap="onCopyOrderReceipt">复制小票</view>
    <view wx:if="{{order.status === 'pending'}}" class="reschedule">
      <view class="reschedule-toggle" bindtap="onToggleSlotEdit">{{slotEditVisible ? '收起改时间' : '改餐次 / 日期'}}</view>
      <view wx:if="{{slotEditVisible}}" class="reschedule-panel">
        <view class="reschedule-label">餐次</view>
        <view class="reschedule-meals">
          <view
            wx:for="{{meals}}"
            wx:key="id"
            class="reschedule-meal {{slotMeal === item.id ? 'active' : ''}}"
            data-meal="{{item.id}}"
            bindtap="onSelectSlotMeal"
          >{{item.name}}</view>
        </view>
        <view class="reschedule-label">日期</view>
        <picker
          mode="date"
          start="{{todayDate}}"
          end="{{maxDate}}"
          value="{{slotDate}}"
          bindchange="onSlotDateChange"
        >
          <view class="reschedule-date">📅 {{slotDateText}}</view>
        </picker>
        <view
          class="reschedule-save {{slotSaving ? 'disabled' : ''}}"
          bindtap="onSaveSlot"
        >{{slotSaving ? '保存中…' : '保存时间'}}</view>
      </view>
    </view>
  </view>

  <view class="block card">
    <view class="block-title">进度</view>
    <view class="timeline">
      <view
        wx:for="{{steps}}"
        wx:key="status"
        class="tstep {{item.done ? 'done' : ''}}"
      >
        <view class="rail">
          <view class="dot"></view>
          <view wx:if="{{index < steps.length - 1}}" class="line"></view>
        </view>
        <view class="tinfo">
          <view class="ttitle">{{item.title}}</view>
          <view wx:if="{{item.time}}" class="ttime">{{item.time}}</view>
          <view wx:if="{{item.deltaText}}" class="tdelta">距上一步 {{item.deltaText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="block card">
    <view class="block-title">留言</view>
    <view wx:if="{{!messages.length}}" class="message-empty">想说的话可以留在这里</view>
    <view
      wx:for="{{messages}}"
      wx:key="key"
      class="message-row {{item.role}}"
    >
      <view class="message-bubble">
        <view class="message-meta">{{item.roleText}} · {{item.timeText}}</view>
        <view class="message-text">{{item.content}}</view>
      </view>
    </view>
    <view wx:if="{{order.status !== 'cancelled'}}" class="message-presets">
      <view
        wx:for="{{messagePresets}}"
        wx:key="*this"
        class="message-preset"
        data-text="{{item}}"
        bindtap="onMessagePreset"
      >{{item}}</view>
    </view>
    <view wx:if="{{order.status !== 'cancelled'}}" class="message-input-row">
      <input
        class="message-input"
        maxlength="100"
        placeholder="说一句…"
        value="{{messageDraft}}"
        confirm-type="send"
        bindinput="onMessageInput"
        bindconfirm="onSendMessage"
      />
      <view
        class="message-send {{sendingMessage ? 'disabled' : ''}}"
        bindtap="onSendMessage"
      >{{sendingMessage ? '发送中…' : '发送'}}</view>
    </view>
  </view>

  <view class="block card">
    <view class="block-title">这顿吃了啥</view>
    <view wx:for="{{order.items}}" wx:key="key" class="item">
      <view class="item-left">
        <view class="item-name">{{item.name}} <text class="item-qty">×{{item.qty}}</text></view>
        <view wx:if="{{item.specText}}" class="item-spec">{{item.specText}}</view>
        <view wx:if="{{item.allergens && item.allergens.length}}" class="item-allergen">含：{{item.allergens}}</view>
        <view wx:if="{{item.note}}" class="item-spec">备注：{{item.note}}</view>
      </view>
      <text class="item-price">¥{{item.lineTotal}}</text>
    </view>
    <view wx:if="{{order.note}}" class="order-note">整单备注：{{order.note}}</view>
    <view
      wx:if="{{order.status === 'pending' || order.status === 'accepted'}}"
      class="edit-note"
      bindtap="onEditNote"
    >{{order.note ? '改整单备注' : '+ 加整单备注'}}</view>
    <view class="total-row">
      <text>合计</text>
      <text class="total-price">¥{{order.amount}}</text>
    </view>
  </view>

  <view wx:if="{{order.status === 'completed'}}" class="block card">
    <view class="block-title">这一顿怎么样？</view>
    <view class="rating-row">
      <view
        wx:for="{{ratingOptions}}"
        wx:key="value"
        class="rating-option {{rating === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onRate"
      >
        <text class="rating-emoji">{{item.emoji}}</text>
        <text class="rating-label">{{item.label}}</text>
      </view>
    </view>
    <view class="rating-tags">
      <view
        wx:for="{{ratingTagOptions}}"
        wx:key="name"
        class="rating-tag {{item.active ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="onToggleRatingTag"
      >{{item.name}}</view>
    </view>
    <view class="rating-images">
      <view wx:for="{{ratingImages}}" wx:key="*this" class="rating-image-item">
        <image class="rating-image" src="{{item}}" mode="aspectFill" data-src="{{item}}" catchtap="onPreviewRatingImage" />
        <view class="rating-image-remove" data-index="{{index}}" catchtap="onRemoveRatingImage">×</view>
      </view>
      <view
        wx:if="{{ratingImages.length < 3}}"
        class="rating-image-add {{uploadingRatingImage ? 'busy' : ''}}"
        bindtap="onAddRatingImage"
      >{{uploadingRatingImage ? '上传中…' : '+ 晒图'}}</view>
    </view>
    <input
      class="rating-input"
      placeholder="想对掌勺的说点什么（选填）"
      value="{{feedbackDraft}}"
      maxlength="50"
      bindinput="onFeedback"
    />
    <view
      class="rating-submit {{submittingRating ? 'disabled' : ''}}"
      bindtap="onSubmitRating"
    >{{submittingRating ? '提交中…' : (order.rating ? '更新评价' : '提交评价')}}</view>

    <view wx:if="{{order.ownerReply}}" class="owner-reply">
      <view class="owner-reply-head">
        <text class="owner-reply-label">掌勺人说</text>
        <text wx:if="{{order.ownerReplyText}}" class="owner-reply-time">{{order.ownerReplyText}}</text>
      </view>
      <view class="owner-reply-text">{{order.ownerReply}}</view>
    </view>
  </view>

  <view class="block card">
    <view class="block-title">小票</view>
    <view class="receipt-row">
      <text>下单时间</text>
      <text>{{order.createdText}}</text>
    </view>
    <view class="receipt-row">
      <text>用餐方式</text>
      <text>{{order.mode}}</text>
    </view>
    <view class="receipt-row">
      <text>哪一天</text>
      <text>{{order.scheduledText}}</text>
    </view>
    <view class="receipt-row">
      <text>期望时间</text>
      <text>{{order.expectedTime}}</text>
    </view>
    <view wx:if="{{order.address}}" class="receipt-row">
      <text>送到</text>
      <text>{{order.address}}</text>
    </view>
    <view wx:if="{{order.profileText}}" class="receipt-row">
      <text>口味</text>
      <text>{{order.profileText}}</text>
    </view>
    <view class="receipt-stamp">记你账上 ♥</view>
  </view>

  <view class="actions">
    <view class="btn btn-ink {{reordering ? 'busy' : ''}}" bindtap="onReorder">{{reordering ? '加购中…' : '再来一单'}}</view>
    <view class="btn" bindtap="onBackHome">回首页</view>
  </view>
</view>

<view wx:elif="{{orderError}}" class="page">
  <empty-state
    title="订单加载失败"
    desc="{{orderError}}"
    actionText="再试一次"
    bind:action="onRetry"
  />
</view>

<view wx:else class="page">
  <view class="skeleton sk-detail"></view>
</view>
