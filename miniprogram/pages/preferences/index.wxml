<view class="page">
  <view class="head">
    <text class="title display">口味与档案</text>
    <text class="sub">让每一顿都合口味，重要日子不忘记</text>
  </view>

  <view wx:if="{{loading}}" class="skeleton sk"></view>

  <empty-state
    wx:elif="{{loadFailed}}"
    title="档案加载失败"
    desc="没有拿到已保存的档案，先别保存，免得覆盖掉"
    actionText="重试"
    bind:action="onRetryLoad"
  />

  <block wx:else>
    <view class="card block">
      <view class="field">
        <text class="label">忌口</text>
        <input
          class="input"
          placeholder="逗号分隔，如：香菜，葱"
          value="{{dislikesText}}"
          bindinput="onDislikes"
        />
      </view>
      <view class="field">
        <text class="label">口味</text>
        <input
          class="input"
          placeholder="逗号分隔，如：微辣，少盐"
          value="{{tastesText}}"
          bindinput="onTastes"
        />
      </view>
      <view class="field">
        <text class="label">常用地址</text>
        <input
          class="input"
          placeholder="送到哪里"
          value="{{address}}"
          maxlength="60"
          bindinput="onAddress"
        />
      </view>
      <view class="field">
        <text class="label">生日</text>
        <view class="date-row">
          <picker
            class="date-picker"
            mode="date"
            value="{{birthday}}"
            start="1900-01-01"
            end="{{today}}"
            bindchange="onBirthday"
          >
            <view class="date-value {{birthday ? '' : 'placeholder'}}">{{birthday || '选择生日'}}</view>
          </picker>
          <view wx:if="{{birthday}}" class="date-clear" catchtap="onClearBirthday">清除</view>
        </view>
      </view>
      <view class="field">
        <text class="label">纪念日</text>
        <view class="date-row">
          <picker
            class="date-picker"
            mode="date"
            value="{{anniversary}}"
            start="1900-01-01"
            end="{{today}}"
            bindchange="onAnniversary"
          >
            <view class="date-value {{anniversary ? '' : 'placeholder'}}">{{anniversary || '选择纪念日'}}</view>
          </picker>
          <view wx:if="{{anniversary}}" class="date-clear" catchtap="onClearAnniversary">清除</view>
        </view>
      </view>
      <view class="date-hint">保存后，未来 30 天内会在厨房端提醒掌勺人。</view>
    </view>

    <view
      class="save-btn {{saving ? 'disabled' : ''}}"
      bindtap="onSave"
    >{{saving ? '保存中…' : '保存'}}</view>
  </block>
</view>
