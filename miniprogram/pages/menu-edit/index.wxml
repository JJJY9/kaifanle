<view class="page">
  <view class="head">
    <text class="title display">排菜单</text>
    <text class="sub">选好这一餐供应什么，卖完可以随时改</text>
  </view>

  <view class="chip-row">
    <view
      wx:for="{{dates}}"
      wx:key="value"
      class="chip {{selectedDate === item.value ? 'active' : ''}}"
      data-value="{{item.value}}"
      bindtap="onSelectDate"
    >{{item.label}}</view>
  </view>

  <view class="chip-row">
    <view
      wx:for="{{meals}}"
      wx:key="id"
      class="chip {{meal === item.id ? 'active' : ''}}"
      data-meal="{{item.id}}"
      bindtap="onSelectMeal"
    >{{item.name}}</view>
  </view>

  <view class="open-row card">
    <text class="open-label">这一餐接单</text>
    <switch checked="{{open}}" color="#FF6B35" bindchange="onToggleOpen" />
  </view>

  <view wx:if="{{loading}}" class="skeleton sk"></view>

  <block wx:elif="{{dishes.length}}">
    <view class="dish-card card">
      <view
        wx:for="{{dishes}}"
        wx:key="id"
        class="dish-row"
        data-id="{{item.id}}"
        bindtap="onToggleDish"
      >
        <view class="dish-dot" style="background: {{item.color}};">{{item.emoji || item.char}}</view>
        <view class="dish-info">
          <view class="dish-name">{{item.name}}</view>
          <view class="dish-sub">{{item.categoryName}} · ¥{{item.price}}</view>
        </view>
        <view class="check {{item.checked ? 'on' : ''}}">{{item.checked ? '✓' : ''}}</view>
      </view>
    </view>

    <view class="save-btn {{saving ? 'disabled' : ''}}" bindtap="onSave">
      {{saving ? '保存中…' : '保存菜单'}}
    </view>
    <view class="copy-btn {{saving ? 'disabled' : ''}}" bindtap="onCopyToComing">复制到未来 7 天</view>

    <view class="template-row">
      <view class="template-btn" bindtap="onSaveTemplate">存为模板</view>
      <view class="template-btn" bindtap="onApplyTemplate">
        套用模板{{templates.length ? '（' + templates.length + '）' : ''}}
      </view>
    </view>

    <view class="reset-btn" bindtap="onReset">恢复默认（全部菜品）</view>
  </block>

  <empty-state
    wx:else
    title="这一餐还没有可选菜品"
    desc="去菜品管理里把菜勾选到这一餐，再回来排菜单"
  />
</view>
