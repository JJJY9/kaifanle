page {
  --bg: #FFFDF6;
  --surface: #FFFFFF;
  --ink: #111111;
  --ink-2: #5C5C5C;
  --orange: #FF6B35;
  --blue: #2D9CFF;
  --yellow: #FFD23F;
  --pink: #FF5C8A;
  --green: #2FBF71;
  --muted: #B8B8B8;
  --radius: 40rpx;
  --shadow: 8rpx 8rpx 0 var(--ink);
  --font-display: 'SmileySans', 'PingFang SC', 'HarmonyOS Sans', sans-serif;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'HarmonyOS Sans', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
input,
textarea,
button,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.card {
  background: var(--surface);
  border: 4rpx solid var(--ink);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.display {
  font-family: var(--font-display);
  font-weight: 800;
  letter-spacing: 1rpx;
}

.price {
  font-family: var(--font-display);
  font-weight: 800;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0 40rpx;
  border: 4rpx solid var(--ink);
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 8rpx 8rpx 0 var(--ink);
  transition: transform 0.08s ease, box-shadow 0.08s ease;
}

.btn:active {
  transform: translate(8rpx, 8rpx);
  box-shadow: 0 0 0 var(--ink);
}

.btn-primary {
  background: var(--orange);
  color: #ffffff;
}

.btn-ink {
  background: var(--ink);
  color: #ffffff;
}

.btn-block {
  width: 100%;
}

.tag-line {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  background: var(--yellow);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.page-pad {
  padding: 24rpx;
}

.muted {
  color: var(--ink-2);
}

.skeleton {
  background: #EFE9DC;
  border: 4rpx solid var(--ink);
  border-radius: var(--radius);
  animation: skeleton-pulse 1.1s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}
